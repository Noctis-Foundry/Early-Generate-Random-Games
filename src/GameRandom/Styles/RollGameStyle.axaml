<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style Selector="DockPanel.RollGameRoot">
        <Setter Property="Background" Value="{StaticResource PaperLinearGradient}" />
    </Style>

    <Style Selector="DockPanel.RollGameRoot Border.HeaderBorder,
                    DockPanel.RollGameRoot Border.ContentBorder,
                    DockPanel.RollGameRoot Border.GameBorder,
                    DockPanel.RollGameRoot Border.InputBorder">
        <Setter Property="Background" Value="{StaticResource WhitePinkGradientStartColor}" />
        <Setter Property="BorderBrush" Value="{StaticResource MangaLineColor}" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>

    <Style Selector="DockPanel.RollGameRoot TextBlock.HeaderText">
        <Setter Property="Foreground" Value="{StaticResource InkBlackColor}" />
        <Setter Property="FontFamily" Value="{StaticResource 'Anime Ace'}" />
        <Setter Property="Padding" Value="5"></Setter>
        <Setter Property="FontSize" Value="22" />
    </Style>

    <Style Selector="DockPanel.RollGameRoot Button.RandomButton">
        <Setter Property="Theme" Value="{StaticResource DefaultButton}" />
        <Setter Property="MaxWidth" Value="300"></Setter>
        <Setter Property="Padding" Value="2" />
    </Style>

    <Style Selector="DockPanel.RollGameRoot Image.GameImages">
        <Setter Property="Stretch" Value="UniformToFill"/>
    </Style>

    <Style Selector="DockPanel.RollGameRoot Button.GenerateButton,
                    DockPanel.RollGameRoot Button.CloseButton">
        <Setter Property="Theme" Value="{StaticResource DefaultButton}" />
    </Style>

    <Style Selector="DockPanel.RollGameRoot TextBlock.GenerateButtonText">
        <Setter Property="Foreground" Value="{StaticResource InkBlackColor}" />
        <Setter Property="FontFamily" Value="{StaticResource 'Anime Ace'}" />
    </Style>

    <Style Selector="DockPanel.RollGameRoot MaskedTextBox.CountInput">
        <Setter Property="Foreground" Value="{StaticResource InkBlackColor}" />
        <Setter Property="Background" Value="{StaticResource PaperWhiteColor}" />
        <Setter Property="BorderBrush" Value="{StaticResource MangaLineColor}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="DockPanel.RollGameRoot CheckBox">
        <Setter Property="Foreground" Value="{StaticResource InkBlackColor}" />
        <Setter Property="FontFamily" Value="{StaticResource 'Anime Ace'}" />
    </Style>
</Styles>
