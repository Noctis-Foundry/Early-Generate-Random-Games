<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Design.PreviewWith>
        <Border Padding="20">
            <StackPanel>
                <Grid RowDefinitions="Auto, Auto" RowSpacing="10">
                    <Border Classes="WindowTextBorder">
                        <TextBlock Classes="WindowTextBlock" Text="Loading..." />
                    </Border>

                    <ProgressBar Classes="LoadingProgress" x:Name="WaitBar"
                                 Grid.Row="1"/>
                </Grid>
            </StackPanel>
        </Border>
    </Design.PreviewWith>

    <Style Selector="Border.WindowTextBorder">
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Background" Value="Transparent"></Setter>
        <Setter Property="BorderBrush" Value="{StaticResource MangaLineColor}"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="MinWidth" Value="300"></Setter>
    </Style>

    <Style Selector="TextBlock.WindowTextBlock">
        <!-- Font Setting -->
        <Setter Property="Foreground" Value="Black"/>
        <Setter Property="FontSize" Value="16"/>
        
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <Style Selector="ProgressBar.LoadingProgress">
        <!-- Width/Height Settings-->
        <Setter Property="MinWidth" Value="200"/>
        <Setter Property="MaxWidth" Value="250"/>
        <Setter Property="Height" Value="15"/> 
        
        <!-- Border Properties -->
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="BorderBrush" Value="{StaticResource MangaLineColor}"/>
        <Setter Property="BorderThickness" Value="1"/>
        
        <!-- Color Settings -->
        <Setter Property="Background" Value="{StaticResource PaperLinearGradientRevers}"/>
        <Setter Property="Foreground" Value="Black"/>
        
        <!-- Progress bar properties -->
        <Setter Property="IsIndeterminate" Value="True"></Setter>
    </Style>
</Styles>
