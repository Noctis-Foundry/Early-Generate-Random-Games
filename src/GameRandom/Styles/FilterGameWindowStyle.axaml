<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style Selector="DockPanel.FilterGameWindowRoot">
        <Setter Property="Background" Value="{StaticResource PaperLinearGradient}" />
    </Style>

    <Style Selector="DockPanel.FilterGameWindowRoot Border.FilterHeader,
                    DockPanel.FilterGameWindowRoot Border.FilterContent">
        <Setter Property="Background" Value="{StaticResource WhitePinkGradientStartColor}" />
        <Setter Property="BorderBrush" Value="{StaticResource MangaLineColor}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="DockPanel.FilterGameWindowRoot ListBox.FilteredBox">
        <Setter Property="Background" Value="{StaticResource PaperWhiteColor}" />
        <Setter Property="BorderBrush" Value="{StaticResource MangaLineColor}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource InkBlackColor}" />
    </Style>

    <Style Selector="DockPanel.FilterGameWindowRoot ListBox.FilteredBox TextBlock,
                    DockPanel.FilterGameWindowRoot TextBlock.FilteredBox">
        <Setter Property="Foreground" Value="{StaticResource InkBlackColor}" />
    </Style>

    <Style Selector="DockPanel.FilterGameWindowRoot ListBox.FilteredBox ListBoxItem">
        <Setter Property="Padding" Value="8,4" />
    </Style>

    <Style Selector="DockPanel.FilterGameWindowRoot ListBox.FilteredBox ListBoxItem:selected /template/ContentPresenter">
        <Setter Property="Background" Value="{StaticResource SakuraLinearGradient}" />
        <Setter Property="Foreground" Value="{StaticResource InkBlackColor}" />
    </Style>
</Styles>
