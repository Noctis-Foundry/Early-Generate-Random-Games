<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style Selector="DockPanel.TaskLoadingRoot Grid.WindowGrid">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>

    <Style Selector="DockPanel.TaskLoadingRoot ProgressBar.LoadingProgress">
        <Setter Property="Foreground" Value="{StaticResource MangaLineColor}" />
    </Style>
</Styles>
