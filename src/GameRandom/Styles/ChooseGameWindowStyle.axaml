<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style Selector="DockPanel.ChooseGameWindowRoot">
        <Setter Property="Background" Value="{StaticResource PaperLinearGradient}" />
    </Style>

    <Style Selector="DockPanel.ChooseGameWindowRoot Border.WindowTextBorder">
        <Setter Property="MaxWidth" Value="350"/>
        <Setter Property="Padding" Value="0"></Setter>
    </Style>

    <Style Selector="DockPanel.ChooseGameWindowRoot Grid.WindowGrid">
        <Setter Property="RowSpacing" Value="6" />
    </Style>
</Styles>
