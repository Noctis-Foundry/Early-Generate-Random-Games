<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========================================================= -->
    <!-- Preview                                                   -->
    <!-- ========================================================= -->

    <Design.PreviewWith>
        <Border Padding="20" Width="800" Height="800">
            <Border Classes="TopContainer"
                    DockPanel.Dock="Top"
                    x:Name="TopContainer">

                <Grid Classes="MainMenuGrid"
                      ColumnDefinitions="*,Auto">

                    <!-- Menu -->
                    <Menu Classes="MainMenu">
                        <MenuItem Classes="MainMenuItem" Header="Lobby System"/>
                        <MenuItem Classes="MainMenuItem" Header="Rulesets"/>
                        <MenuItem Classes="MainMenuItem" Header="Admin Panel"/>
                    </Menu>

                    <!-- User / Avatar area -->
                    <Grid Classes="LobbyImagesGrid"
                          Grid.Column="1"
                          x:Name="LobbyImages">

                        <Border Classes="AvatarBorder">
                            <Image Source="avares://GameRandom/Assets/steamAwatarWithNight.jpg"/>
                        </Border>

                    </Grid>

                </Grid>

            </Border>
        </Border>
    </Design.PreviewWith>


    <!-- ========================================================= -->
    <!-- Top Container                                             -->
    <!-- ========================================================= -->

    <Style Selector="Border.TopContainer">
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                    <GradientStop Color="#E8E8E8" Offset="0"/>
                    <GradientStop Color="#C8C8C8" Offset="1"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>

        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="3"/>
    </Style>


    <!-- ========================================================= -->
    <!-- Main Menu Grid                                            -->
    <!-- ========================================================= -->

    <Style Selector="Grid.MainMenuGrid">
        <Setter Property="ColumnSpacing" Value="15"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="Background" Value="Transparent"></Setter>
    </Style>

    
    <!-- ========================================================= -->
    <!-- Main Menu                                         -->
    <!-- ========================================================= -->

    <Style Selector="MenuItem.MainMenu">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
    </Style>
    
    <!-- ========================================================= -->
    <!-- Menu Item                                                 -->
    <!-- ========================================================= -->

    <Style Selector="MenuItem.MainMenuItem">
        <Setter Property="Margin" Value="5,2"/>

        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                    <GradientStop Color="LightCyan" Offset="0"/>
                    <GradientStop Color="LightBlue" Offset="1"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>

        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="Black"/>
    </Style>


    <!-- ========================================================= -->
    <!-- Menu Item Hover                                           -->
    <!-- ========================================================= -->

    <Style Selector="MenuItem.MainMenuItem:pointerover /template/ Border#PART_LayoutRoot">
        <Setter Property="BorderThickness" Value="1"/>

        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                    <GradientStop Color="Gray" Offset="0"/>
                    <GradientStop Color="LightGray" Offset="1"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- ========================================================= -->
    <!-- Menu Text                                                 -->
    <!-- ========================================================= -->

    <Style Selector="MenuItem.MainMenuItem /template/ContentPresenter#PART_HeaderPresenter">
        <Setter Property="FontFamily" Value="{StaticResource 'Anime Ace'}"/>
        <Setter Property="Foreground" Value="Black"/>
    </Style>


    <!-- ========================================================= -->
    <!-- Avatar Area                                               -->
    <!-- ========================================================= -->

    <Style Selector="Grid.LobbyImagesGrid">
        <Setter Property="ColumnSpacing" Value="5"/>
        <Setter Property="Margin" Value="0,0,1,0"/>
    </Style>


    <!-- ========================================================= -->
    <!-- Avatar Border                                             -->
    <!-- ========================================================= -->

    <Style Selector="Border.AvatarBorder">
        <Setter Property="ClipToBounds" Value="True"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="BorderThickness" Value="10"/>
        <Setter Property="Background" Value="Transparent"/>
    </Style>

</Styles>