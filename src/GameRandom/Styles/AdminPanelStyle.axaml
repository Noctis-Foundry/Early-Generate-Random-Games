<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <Design.PreviewWith>
        <Border Width="800" Height="450" Background="#2f2f2d">
            <DataGrid Width="700" Height="350" Classes="AdminDataGrid">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Player" Width="150"/>
                    <DataGridTextColumn Header="Game" Width="250"/>
                    <DataGridTextColumn Header="Completed Date" Width="150"/>
                    <DataGridTextColumn Header="Status" Width="150"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Design.PreviewWith>
    
    <Style Selector="DataGrid.AdminDataGrid">
        <Setter Property="BorderBrush" Value="#d4af37"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="GridLinesVisibility" Value="All"/>
        <Setter Property="Background" Value="#1a1a1a"/>
        <Setter Property="CanUserResizeColumns" Value="True"/>
        <Setter Property="CanUserSortColumns" Value="True"/>
    </Style>
    
    <Style Selector="DataGrid.AdminDataGrid DataGridColumnHeader">
        <Setter Property="Background" Value="#3a3a3a"/>
        <Setter Property="Foreground" Value="#d4af37"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontFamily" Value="{DynamicResource 'Anime Ace'}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"></Setter>
    </Style>
    
    <Style Selector="DataGrid.AdminDataGrid DataGridColumnHeader TextBlock">
        <Setter Property="Foreground" Value="#d4af37"></Setter>
        <Setter Property="FontFamily" Value="{StaticResource 'Anime Ace'}"></Setter>
    </Style>
    
    <Style Selector="DataGrid.AdminDataGrid DataGridRow">
        <Setter Property="Background" Value="#2a2a2a"/>
    </Style>
    
    <Style Selector="DataGrid.AdminDataGrid DataGridRow:selected">
        <Setter Property="Background" Value="#4a4a4a"/>
    </Style>
    
    <Style Selector="DataGrid.AdminDataGrid DataGridRow TextBlock">
        <Setter Property="Foreground" Value="WhiteSmoke"/>
        <Setter Property="FontSize" Value="14"/>
    </Style>
    
    <Style Selector="Border.RatingDialog">
        <Setter Property="Background" Value="#2f2f2d"/>
        <Setter Property="BorderBrush" Value="#d4af37"/>
        <Setter Property="BorderThickness" Value="3"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="30"/>
    </Style>
    
    <Style Selector="TextBlock.RatingTitle">
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="#d4af37"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>
    
    <Style Selector="TextBlock.RatingLabel">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Foreground" Value="WhiteSmoke"/>
        <Setter Property="Margin" Value="0,10,0,5"/>
    </Style>
    
    <Style Selector="NumericUpDown.RatingInput">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Minimum" Value="1"/>
        <Setter Property="Maximum" Value="10"/>
        <Setter Property="Increment" Value="1"/>
    </Style>
    
    <Style Selector="Button.RatingButton">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Padding" Value="20,10"/>
        <Setter Property="Margin" Value="10"/>
        <Setter Property="Background" Value="#d4af37"/>
        <Setter Property="Foreground" Value="#1a1a1a"/>
        <Setter Property="CornerRadius" Value="5"/>
    </Style>
    
    <Style Selector="Button.RatingButton:pointerover">
        <Setter Property="Background" Value="#f0c040"/>
    </Style>
</Styles>
