<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style Selector="Grid.AdminPanelRoot">
        <Setter Property="Background" Value="{StaticResource PaperLinearGradient}" />
    </Style>

    <Style Selector="Grid.AdminPanelRoot TextBlock.RatingTitle">
        <Setter Property="Foreground" Value="{StaticResource InkBlackColor}" />
        <Setter Property="FontFamily" Value="{StaticResource 'Anime Ace'}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="Grid.AdminPanelRoot DataGrid.AdminDataGrid">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource InkBlackColor}" />
        <Setter Property="BorderBrush" Value="{StaticResource MangaLineColor}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="GridLinesVisibility" Value="All" />
    </Style>
</Styles>
