<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style Selector="DockPanel.CurrentGameRoot">
        <Setter Property="Background" Value="{StaticResource PaperLinearGradient}" />
    </Style>

    <Style Selector="Border.CurrentGameTextBorder">
        <Setter Property="MinWidth" Value="300"/>
        
        <Setter Property="MaxWidth" Value="350"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalAlignment" Value="Left"></Setter>
    </Style>
    
    <Style Selector="TextBlock.CurrentGameTextBlock">
        <Setter Property="Margin" Value="10"></Setter>
        <Setter Property="TextWrapping" Value="Wrap"></Setter>
        <Setter Property="FontSize" Value="16"></Setter>
        <Setter Property="HorizontalAlignment" Value="Stretch"></Setter>
        <Setter Property="VerticalAlignment" Value="Stretch"></Setter>
    </Style>
    
    <Style Selector="DockPanel.CurrentGameRoot Grid.WindowGrid">
        <Setter Property="RowSpacing" Value="8" />
    </Style>
</Styles>
