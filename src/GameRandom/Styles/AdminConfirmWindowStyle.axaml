<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style Selector="DockPanel.AdminConfirmWindowRoot">
        <Setter Property="Background" Value="{StaticResource PaperLinearGradient}" />
    </Style>

    <Style Selector="DockPanel.AdminConfirmWindowRoot Grid.WindowGrid">
        <Setter Property="RowSpacing" Value="8" />
    </Style>

</Styles>
