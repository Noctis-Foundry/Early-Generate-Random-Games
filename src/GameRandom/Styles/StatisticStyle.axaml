<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GameRandom.ViewModels.AdminConfirmSystem"
        xmlns:statisticSystem="clr-namespace:GameRandom.ViewModels.StatisticSystem"
        x:DataType="statisticSystem:StatisticViewModel">

    <Design.PreviewWith>
         <Border Classes="StatisticContainer" Height="400" Width="700">
        <Border.Background>
            <ImageBrush Source="avares://GameRandom/Assets/TableBorder1920.png"
                        Stretch="Fill">
            </ImageBrush>
        </Border.Background>
        <Grid RowDefinitions="Auto, Auto" HorizontalAlignment="Center" Margin="0,50,0,0">
            <Border Classes="StatisticHeader" Height="50" Width="450">
                <Grid ColumnDefinitions="*, Auto">
                    <TextBlock Text="Player Statistic"
                               Classes="StatisticHeaderText">
                    </TextBlock>

                    <Button Grid.Column="1" Classes="ProfileButtons"
                            HorizontalAlignment="Right">
                        Games Table
                    </Button>
                </Grid>
            </Border>
            
            <Grid Grid.Row="1" RowDefinitions="Auto, Auto" ColumnDefinitions="Auto, Auto, Auto" Classes="CardContainer"
                  x:Name="StatisticCardGrid">
                <Border Classes="StatisticPropertyBorder">
                    <Grid Classes="CardBorderGrid" RowDefinitions="Auto, Auto, Auto">
                        <TextBlock Classes="StatisticCardText" Text="Games Count"></TextBlock>
                        <Separator Grid.Row="1"></Separator>
                        <TextBlock Grid.Row="2" Classes="StatisticCardText" Text="183"></TextBlock>
                    </Grid>
                </Border>
                
                <Border Grid.Row="0" Grid.Column="1" Classes="StatisticPropertyBorder">
                    <Grid Classes="CardBorderGrid" RowDefinitions="Auto, Auto, Auto">
                        <TextBlock Classes="StatisticCardText" Text="Finished games count"></TextBlock>
                        <Separator Grid.Row="1"></Separator>
                        <TextBlock Grid.Row="2" Classes="StatisticCardText" Text="183"></TextBlock>
                    </Grid>
                </Border>
                
                <Border Grid.Row="0" Grid.Column="2" Classes="StatisticPropertyBorder">
                    <Grid Classes="CardBorderGrid" RowDefinitions="Auto, Auto, Auto">
                        <TextBlock Classes="StatisticCardText" Text="Finished games count"></TextBlock>
                        <Separator Grid.Row="1"></Separator>
                        <TextBlock Grid.Row="2" Classes="StatisticCardText" Text="183"></TextBlock>
                    </Grid>
                </Border>
                <Border Grid.Row="1" Grid.Column="0" Classes="StatisticPropertyBorder">
                    <Grid Classes="CardBorderGrid" RowDefinitions="Auto, Auto, Auto">
                        <TextBlock Classes="StatisticCardText" Text="Finished games count"></TextBlock>
                        <Separator Grid.Row="1"></Separator>
                        <TextBlock Grid.Row="2" Classes="StatisticCardText" Text="183"></TextBlock>
                    </Grid>
                </Border>
                <Border Grid.Row="1" Grid.Column="1" Classes="StatisticPropertyBorder">
                    <Grid Classes="CardBorderGrid" RowDefinitions="Auto, Auto, Auto">
                        <TextBlock Classes="StatisticCardText" Text="Finished games count"></TextBlock>
                        <Separator Grid.Row="1"></Separator>
                        <TextBlock Grid.Row="2" Classes="StatisticCardText" Text="183"></TextBlock>
                    </Grid>
                </Border>
                <Border Grid.Row="1" Grid.Column="2" Classes="StatisticPropertyBorder">
                    <Grid Classes="CardBorderGrid" RowDefinitions="Auto, Auto, Auto">
                        <TextBlock Classes="StatisticCardText" Text="Finished games count"></TextBlock>
                        <Separator Grid.Row="1"></Separator>
                        <TextBlock Grid.Row="2" Classes="StatisticCardText" Text="183"></TextBlock>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
    </Design.PreviewWith>
    
    <!-- Container grid that holds statistic cards -->
    <Style Selector="Grid.CardContainer">
        <Setter Property="ColumnSpacing" Value="15"/>
        <Setter Property="Margin" Value="15, 15, 0, 0"/>
        <Setter Property="RowSpacing" Value="15"/>
    </Style>

    <!-- Outer border of a single statistic card -->
    <Style Selector="Border.StatisticPropertyBorder">
        <!-- Transparent background, fixed size, rounded corners -->
        <Setter Property="Background" Value="CadetBlue"/>
        <Setter Property="Width" Value="130"/>
        <Setter Property="Height" Value="100"/>
        <Setter Property="CornerRadius" Value="10"/>
    </Style>

    <!-- Inner grid of the card (title / separator / data) -->
    <Style Selector="Grid.CardBorderGrid">
        <!-- Center content vertically and add spacing between rows -->
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="RowSpacing" Value="10"/>
    </Style>

    <!-- Text inside statistic cards -->
    <Style Selector="TextBlock.StatisticCardText">
        <!-- Centered text, custom font, white color -->
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="FontFamily" Value="{DynamicResource 'Anime Ace'}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="TextWrapping" Value="Wrap"></Setter>
        <Setter Property="FontSize" Value="14"></Setter>
        <Setter Property="TextAlignment" Value="Center"></Setter>
    </Style>

    <!-- Main statistics container -->
    <Style Selector="Border.StatisticContainer">
        <!-- Transparent background with top padding -->
        <Setter Property="BorderBrush" Value="Blue"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="0,4,0,0"/>
    </Style>

    <!-- Statistics section header with animated border -->
    <Style Selector="Border.StatisticHeader">
        <!-- Rounded border with animated gradient brush -->
        <Setter Property="BorderBrush"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="CornerRadius" Value="20"/>
        <Setter Property="Padding" Value="20, 0, 20, 0"/>

        <!-- Infinite rotating conic gradient animation -->
        <Style.Animations>
            <Animation Duration="0:0:3" IterationCount="Infinite">
                <KeyFrame Cue="0%">
                    <Setter Property="BorderBrush">
                        <Setter.Value>
                            <ConicGradientBrush Angle="0" Center="50%, 50%">
                                <GradientStop Color="#becdd4" Offset="0.0"/>
                                <GradientStop Color="SlateGray" Offset="1.0"/>
                            </ConicGradientBrush>
                        </Setter.Value>
                    </Setter>
                </KeyFrame>

                <KeyFrame Cue="100%">
                    <Setter Property="BorderBrush">
                        <Setter.Value>
                            <ConicGradientBrush Angle="360" Center="50%, 50%">
                                <GradientStop Color="#becdd4" Offset="0.0"/>
                                <GradientStop Color="SlateGray" Offset="1.0"/>
                            </ConicGradientBrush>
                        </Setter.Value>
                    </Setter>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- Header text styling -->
    <Style Selector="TextBlock.StatisticHeaderText">
        <!-- Light color, increased letter spacing, medium size -->
        <Setter Property="Foreground" Value="#D8D8D8"/>
        <Setter Property="LetterSpacing" Value="5"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

</Styles>
