<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Design.PreviewWith>
        <Border Padding="20">
            <Button Content="Click Me"></Button>
        </Border>
    </Design.PreviewWith>

    <Style Selector="Button">
        <Setter Property="Background" Value="{StaticResource SakuraLinearGradient}"/>
        
        <!-- Border style -->
        <Setter Property="BorderBrush" Value="{StaticResource NeonPurpleColor}"/>
        <Setter Property="BorderThickness" Value="2"/>
        
        <!-- Font style -->
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontFamily" Value="{StaticResource 'Anime Ace'}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="Black"></Setter>
        
        <!-- Content position -->
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        
        <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource LightBlueGradient}"/>
            <Setter Property="Foreground" Value="Black"></Setter>
            <Setter Property="BorderBrush"/>
            <Style.Animations>
                <Animation Duration="0:0:2" IterationCount="Infinite">
                    <KeyFrame Cue="0%">
                        <Setter Property="BorderBrush" Value="{StaticResource StartSkyBorderBrush}"></Setter>
                    </KeyFrame>
                    
                    <KeyFrame Cue="100%">
                        <Setter Property="BorderBrush" Value="{StaticResource EndSkyBorderBrush}"></Setter>
                    </KeyFrame>                
                </Animation>
            </Style.Animations>
        </Style>
    </Style>
</Styles>
