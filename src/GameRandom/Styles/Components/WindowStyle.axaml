<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style Selector="DockPanel.WindowContainer">
        <Setter Property="Background" Value="{StaticResource PaperLinearGradient}" />
    </Style>

    <Style Selector="Border.WindowTopContainer">
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Background" Value="{StaticResource WhitePinkGradientStartColor}" />
        <Setter Property="BorderBrush" Value="{StaticResource MangaLineColor}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>

    <Style Selector="Button.WindowButton">
        <Setter Property="Theme" Value="{StaticResource DefaultButton}" />
    </Style>
    
       <Style Selector="Border.WindowTextBorder">
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Background" Value="Transparent"></Setter>
        <Setter Property="BorderBrush" Value="{StaticResource MangaLineColor}"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="MinWidth" Value="300"></Setter>
    </Style>

    <Style Selector="TextBlock.WindowTextBlock">
        <!-- Font Setting -->
        <Setter Property="Foreground" Value="Black"/>
        <Setter Property="FontSize" Value="16"/>
        
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>
    
    <Style Selector="Border.WindowImageBorder">
        <Setter Property="BorderBrush" Value="{StaticResource MangaLineColor}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="Padding" Value="1" />
        <Setter Property="Background" Value="{StaticResource WhitePinkGradientStartColor}" />
    </Style>

    <Style Selector="Image.WindowHeaderImage">
        <Setter Property="Stretch" Value="UniformToFill" />
    </Style>
</Styles>
