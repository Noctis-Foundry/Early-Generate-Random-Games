<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Design.PreviewWith>
        <Border Padding="20">
            <Button Classes="GameInfoButton" Content="Hello kitty"></Button>
        </Border>
    </Design.PreviewWith>

    <Styles.Resources>
        <ImageBrush Source="avares://GameRandom/Assets/TextBlockBorder.png" Stretch="Fill" x:Key="TextBlockBackground"></ImageBrush>
        <ImageBrush Source="avares://GameRandom/Assets/buttonBorder.png" Stretch="Fill" x:Key="ButtonBackground"></ImageBrush>
    </Styles.Resources>
    
    <!-- Main container style for the game info window background and spacing -->
    <Style Selector="DockPanel.GameInfoContainer">
        <Setter Property="Background" Value="Gray" />
    </Style>

    <!-- Grid layout style: centers content and defines spacing between rows and columns -->
    <Style Selector="Grid.GameInfoGrid">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="RowSpacing" Value="8" />
        <Setter Property="ColumnSpacing" Value="15" />
    </Style>

    <!-- Style for individual info card borders: dark background with rounded corners and padding -->
    <Style Selector="Border.GameInfoItem">
        <Setter Property="Background" Value="{StaticResource TextBlockBackground}"/>
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="13"/>
    </Style>

    <!-- Style for info text labels: white text, centered, with wrapping and size constraints -->
    <Style Selector="TextBlock.GameInfoText">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontFamily" Value="{StaticResource 'Anime Ace'}"></Setter>
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="MaxWidth" Value="230" />
        <Setter Property="MaxHeight" Value="80" />
    </Style>
    
    <Style Selector="SelectableTextBlock.SelectableGameInfo">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="MaxWidth" Value="230" />
        <Setter Property="MaxHeight" Value="80" />
    </Style>

    <!-- Animated border style for game image with rotating conic gradient outline -->
    <Style Selector="Border.GameImageBorder">
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="BorderBrush" />
        <Style.Animations>
            <Animation Duration="0:0:3" IterationCount="Infinite">
                <KeyFrame Cue="0%">
                    <Setter Property="BorderBrush">
                        <Setter.Value>
                            <ConicGradientBrush Center="50%,50%" Angle="0">
                                <GradientStop Color="#FFFFFF" Offset="0" />
                                <GradientStop Color="#C0C0C0" Offset="0.5" />
                                <GradientStop Color="#808080" Offset="1" />
                            </ConicGradientBrush>
                        </Setter.Value>
                    </Setter>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="BorderBrush">
                        <Setter.Value>
                            <ConicGradientBrush Center="50%,50%" Angle="360">
                                <GradientStop Color="#FFFFFF" Offset="0" />
                                <GradientStop Color="#C0C0C0" Offset="0.5" />
                                <GradientStop Color="#808080" Offset="1" />
                            </ConicGradientBrush>
                        </Setter.Value>
                    </Setter>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- Button hover style: animated conic gradient border on pointer over -->
    <Style Selector="Button.GameInfoButton:pointerover /template/ContentPresenter">
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="BorderBrush">
        </Setter>
        <Style.Animations>
            <Animation Duration="0:0:3" IterationCount="Infinite">
                <KeyFrame Cue="0%">
                    <Setter Property="BorderBrush">
                        <Setter.Value>
                            <ConicGradientBrush Center="50%,50%" Angle="0">
                                <GradientStop Color="#bb9e67" Offset="0" />
                                <GradientStop Color="{StaticResource GradientColorMiddle}" Offset="0.5" />
                                <GradientStop Color="{StaticResource GradientColorEnd}" Offset="1" />
                            </ConicGradientBrush>
                        </Setter.Value>
                    </Setter>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="BorderBrush">
                        <Setter.Value>
                            <ConicGradientBrush Center="50%,50%" Angle="360">
                                <GradientStop Color="#bb9e67" Offset="0" />
                                <GradientStop Color="{StaticResource GradientColorMiddle}" Offset="0.5" />
                                <GradientStop Color="{StaticResource GradientColorEnd}" Offset="1" />
                            </ConicGradientBrush>
                        </Setter.Value>
                    </Setter>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    
    <!-- Свойства самой кнопки -->
    <Style Selector="Button.GameInfoButton">
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center"></Setter>
        <Setter Property="FontSize" Value="16" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="MinWidth" Value="150" />
    </Style>

    <!-- Свойства ContentPresenter -->
    <Style Selector="Button.GameInfoButton /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource ButtonBackground}" />
        <Setter Property="Foreground" Value="White"></Setter>
        <Setter Property="CornerRadius" Value="4" />
    </Style>

</Styles>