<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="GameRandom.App"
             xmlns:local="using:GameRandom"
             xmlns:con="using:GameRandom.AvaloniaConverters"
             RequestedThemeVariant="Default">
    <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->
    
    <Application.Resources>
        <ResourceDictionary>
            <con:ImageNullConverter x:Key="NullImageConverter" />
            <con:DictionaryToListConverter x:Key="DictionaryToListConverter"></con:DictionaryToListConverter>
            <con:TimeSpanFormatConverter x:Key="TimeSpanConverter"></con:TimeSpanFormatConverter>
            <con:ArrayTextJoinConverter x:Key="ArrayTextJoinConverter"></con:ArrayTextJoinConverter>
            <con:ByteToImageConverter x:Key="ByteToImageConverter"></con:ByteToImageConverter>
            <con:LongToStringConverter x:Key="LongToStringConverter"></con:LongToStringConverter>
            
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://GameRandom/Resources/FontsResources.axaml"></ResourceInclude>
                <ResourceInclude Source="avares://GameRandom/Resources/Backgrounds.axaml"></ResourceInclude>
                <ResourceInclude Source="avares://GameRandom/Resources/ColorsResources.axaml"></ResourceInclude>
                <ResourceInclude Source="avares://GameRandom/Resources/BorderBrushResources.axaml"></ResourceInclude>
                <ResourceInclude Source="avares://GameRandom/Resources/Themes/ButtonTheme.axaml"></ResourceInclude>
                <ResourceInclude Source="avares://GameRandom/Resources/Themes/BorderTheme.axaml"></ResourceInclude>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
    
    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>
    
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>
        <StyleInclude Source="avares://GameRandom/Styles/Components/TextBlockStyle.axaml"></StyleInclude>
        <StyleInclude Source="avares://GameRandom/Styles/Components/WindowStyle.axaml"></StyleInclude>
        
        
        <StyleInclude Source="avares://GameRandom/Styles/GameTableStyle.axaml"></StyleInclude>
        <StyleInclude Source="avares://GameRandom/Styles/LoadContentStyle.axaml"></StyleInclude>
        <StyleInclude Source="avares://GameRandom/Styles/MainMenuStyle.axaml"></StyleInclude>
        <StyleInclude Source="avares://GameRandom/Styles/MainControlStyle.axaml"></StyleInclude>
        <StyleInclude Source="avares://GameRandom/Styles/Components/WindowStyle.axaml"></StyleInclude>
        <StyleInclude Source="avares://GameRandom/Styles/AdminConfirmWindowStyle.axaml"></StyleInclude>
        <StyleInclude Source="avares://GameRandom/Styles/AdminPanelStyle.axaml"></StyleInclude>
        <StyleInclude Source="avares://GameRandom/Styles/AdminRegistrationWindowStyle.axaml"></StyleInclude>
        <StyleInclude Source="avares://GameRandom/Styles/ChooseGameWindowStyle.axaml"></StyleInclude>
        <StyleInclude Source="avares://GameRandom/Styles/ConfirmDialogStyle.axaml"></StyleInclude>
        <StyleInclude Source="avares://GameRandom/Styles/ConfirmFinishGameStyle.axaml"></StyleInclude>
        <StyleInclude Source="avares://GameRandom/Styles/CurrentGameStyle.axaml"></StyleInclude>
        <StyleInclude Source="avares://GameRandom/Styles/ErrorWindowStyle.axaml"></StyleInclude>
        <StyleInclude Source="avares://GameRandom/Styles/FilterGameWindowStyle.axaml"></StyleInclude>
        <StyleInclude Source="avares://GameRandom/Styles/ProfileContentStyle.axaml"></StyleInclude>
        <StyleInclude Source="avares://GameRandom/Styles/RollGameStyle.axaml"></StyleInclude>
        <StyleInclude Source="avares://GameRandom/Styles/RulesWindowStyle.axaml"></StyleInclude>
        <StyleInclude Source="avares://GameRandom/Styles/StatisticControlStyle.axaml"></StyleInclude>
        <StyleInclude Source="avares://GameRandom/Styles/GamesTableWindowStyle.axaml"></StyleInclude>
        <StyleInclude Source="avares://GameRandom/Styles/LobbyWindowStyle.axaml"></StyleInclude>
        <StyleInclude Source="avares://GameRandom/Styles/TaskLoadingStyle.axaml"></StyleInclude>
    </Application.Styles>
</Application>