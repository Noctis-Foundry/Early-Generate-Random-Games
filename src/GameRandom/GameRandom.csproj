<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
          <Version>0.3.2</Version>
        <Nullable>enable</Nullable>
        <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <LangVersion>14</LangVersion>
        <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    </PropertyGroup>

    <ItemGroup>
        <Folder Include="Models\" />
        <Folder Include="Scripts\Events\" />
        <Content Include="Assets\Localization\**">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <None Include="Assets\icon.ico" />
        <None Include="Assets\Jsons\temp_apps.json">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Include="Assets\Jsons\categories.json">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Include="Assets\Jsons\genres.json">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Include="Assets\avalonia-logo.ico">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <AvaloniaResource Include="Assets\**" />
        <None Include="Libs/steam_api64.dll" CopyToOutputDirectory="Always">
            <Link>steam_api64.dll</Link>
        </None>

        <None Include="Libs/libsteam_api.so" CopyToOutputDirectory="Always">
            <Link>libsteam_api.so</Link>
        </None>

        <None Include="Libs/steam_appid.txt" CopyToOutputDirectory="Always">
            <Link>steam_appid.txt</Link>
        </None>
        <None Include="Libs/libsteam_api.so">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
            <TargetPath>runtimes/linux-x64/native/libsteam_api.so</TargetPath>
        </None>
    </ItemGroup>

    <ItemGroup>
        <!--Condition below is needed to remove Avalonia.Diagnostics package from build output in Release configuration.-->
        <PackageReference Include="Autofac" Version="8.4.0" />
        <PackageReference Include="Avalonia" Version="11.3.11" />
        <PackageReference Include="Avalonia.BuildServices" Version="11.3.2" />
        <PackageReference Include="Avalonia.Desktop" Version="11.3.11" />
        <PackageReference Include="Avalonia.Diagnostics" Version="11.3.11" />
        <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.11" />
        <PackageReference Include="Avalonia.ReactiveUI" Version="11.3.8" />
        <PackageReference Include="Avalonia.Remote.Protocol" Version="11.3.11" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.11" />
        <PackageReference Include="Avalonia.Controls.DataGrid" Version="11.3.11" />
        <PackageReference Include="Avalonia.Labs.Gif" Version="11.3.1" />
        <PackageReference Include="Avalonia.Xaml.Behaviors" Version="11.3.0.6" />

        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.1" />
        <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.9" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.9">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Newtonsoft.Json.Bson" Version="1.0.3" />
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0-rc.1" />
        <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
        <PackageReference Include="Steamworks.NET" Version="2024.8.0" />
        <PackageReference Include="System.Reactive" Version="7.0.0-preview.1" />
        <PackageReference Include="ValveKeyValue" Version="0.70.0.499" />
    </ItemGroup>

    <ItemGroup>
        <Compile Update="Views\MainWindow\GameTable.axaml.cs">
            <DependentUpon>GameTable.axaml</DependentUpon>
            <SubType>Code</SubType>
        </Compile>
        <Compile Update="Views\MainWindow\MainWindow.axaml.cs">
            <DependentUpon>MainWindow.axaml</DependentUpon>
            <SubType>Code</SubType>
        </Compile>
        <Compile Update="Views\MainWindow\MainWindowContent.axaml.cs">
            <DependentUpon>MainWindowContent.axaml</DependentUpon>
            <SubType>Code</SubType>
        </Compile>
        <Compile Update="Views\MainWindow\ProfileContent.axaml.cs">
            <DependentUpon>ProfileContent.axaml</DependentUpon>
            <SubType>Code</SubType>
        </Compile>
        <Compile Update="Views\MainWindow\RollGame.axaml.cs">
            <DependentUpon>RollGame.axaml</DependentUpon>
            <SubType>Code</SubType>
        </Compile>
        <Compile Update="Views\MainWindow\Rules.axaml.cs">
            <DependentUpon>Rules.axaml</DependentUpon>
            <SubType>Code</SubType>
        </Compile>
        <Compile Update="Views\LobbyWindow.axaml.cs">
            <DependentUpon>LobbyWindow.axaml</DependentUpon>
            <SubType>Code</SubType>
        </Compile>
        <Compile Update="Views\ErrorWindow.axaml.cs">
            <DependentUpon>ErrorWindow.axaml</DependentUpon>
        </Compile>
        <Compile Update="Views\ConfirmFinishGame.axaml.cs">
          <DependentUpon>ConfirmFinishGame.axaml</DependentUpon>
        </Compile>
        <Compile Update="Views\FirstWindow\MainWindowSystem\MainWindow.axaml.cs">
          <DependentUpon>MainWindow.axaml</DependentUpon>
          <SubType>Code</SubType>
        </Compile>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\MessageBox\MessageBox.csproj" />
        <ProjectReference Include="..\SteamVDFParser\SteamVDFParser.csproj" />
    </ItemGroup>
</Project>
