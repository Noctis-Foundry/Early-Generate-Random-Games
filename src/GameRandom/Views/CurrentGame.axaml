<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:GameRandom.ViewModels"
        mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="350"
        MaxHeight="350" MaxWidth="700"
        MinHeight="300" MinWidth="600"
        Height="350" Width="650"
        x:Class="GameRandom.Views.CurrentGame"
        x:DataType="vm:CurrentGameStatusViewModel"
        Title="Current game status">

        <!-- Main container for the current game status window -->
        <DockPanel Classes="GameInfoContainer" Height="350" Width="650">
                
                <Border DockPanel.Dock="Top" HorizontalAlignment="Center">
                        <TextBlock Text="Current game" FontSize="20" Foreground="AliceBlue"></TextBlock>
                </Border>
                
                <!-- Main grid layout: left column for info, right column for image and actions -->
                <Grid Classes="GameInfoGrid" RowDefinitions="*, *, *, *, *" DockPanel.Dock="Left" Margin="5,0,0,0">
                        <!-- Game name label -->
                        <Border Grid.Row="0" Grid.Column="0" Classes="GameInfoItem">
                                <TextBlock Text="Name: Dead cells" Classes="GameInfoText" x:Name="GameName"/>
                        </Border>

                        <!-- Date when the game session was started -->
                        <Border Grid.Row="1" Grid.Column="0" Classes="GameInfoItem">
                                <TextBlock Text="Start: 24.04.2026" Classes="GameInfoText" x:Name="StartDate"/>
                        </Border>

                        <!-- Current date -->
                        <Border Grid.Row="2" Grid.Column="0" Classes="GameInfoItem">
                                <TextBlock Text="Today: 26.04.2026" Classes="GameInfoText" x:Name="TodayDate"/>
                        </Border>

                        <!-- Total time spent on the game -->
                        <Border Grid.Row="3" Grid.Column="0" Classes="GameInfoItem">
                                <TextBlock Text="Time: 30day 14h 52m" Classes="GameInfoText" x:Name="TimeSpent"/>
                        </Border>

                        <!-- Expected or deadline end date for the game -->
                        <Border Grid.Row="4" Grid.Column="0" Classes="GameInfoItem">
                                <TextBlock Text="End date: 24.05.2026" Classes="GameInfoText" x:Name="EndDate"/>
                        </Border>
                </Grid>
                
                <Grid DockPanel.Dock="Right" RowDefinitions="Auto, Auto" HorizontalAlignment="Center" VerticalAlignment="Center" RowSpacing="5">
                        <!-- Game cover image or avatar -->
                        <Border Grid.Row="0" Grid.Column="0" Width="350" Height="150" MaxWidth="450" MinWidth="250" 
                                MaxHeight="200" MinHeight="150" Classes="GameImageBorder">
                                <Image Source="avares://GameRandom/Assets/steamAwatarWithNight.jpg" 
                                       Stretch="Fill" x:Name="GameImage"/>
                        </Border>

                        <!-- Action buttons panel -->
                        <Border Grid.Row="1" Grid.Column="0" HorizontalAlignment="Center">
                                <Grid ColumnDefinitions="Auto, Auto" ColumnSpacing="30">

                                        <!-- TODO: Open the game's store page in Steam browser -->
                                        <Button Classes="GameInfoButton" Content="Steam" Click="ShowSteamStore"></Button>
                                        
                                        <Button Grid.Column="1" Classes="GameInfoButton" Content="Finish game" Click="FinishedGame"></Button>

                                </Grid>
                        </Border>
                </Grid>
        </DockPanel>
</Window>