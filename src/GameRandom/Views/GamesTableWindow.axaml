<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:GameRandom.ViewModels.AdminConfirmSystem"
        xmlns:tablesSystem="clr-namespace:GameRandom.ViewModels.TablesSystem"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        Width="800" Height="500"
        MaxHeight="700" MaxWidth="1000"
        MinHeight="500" MinWidth="600"
        x:Class="GameRandom.Views.GamesTableWindow"
        x:DataType="tablesSystem:StatisticGameTableViewModel"
        Title="GamesTable">
    <DockPanel Background="Gray">
        <DataGrid ItemsSource="{Binding TableData}"
                  AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Game name" Binding="{Binding AppName}"></DataGridTextColumn>
                <DataGridTextColumn Header="Begin data" Binding="{Binding BeginTime}"></DataGridTextColumn>
                <DataGridTextColumn Header="End data" Binding="{Binding EndTime}"></DataGridTextColumn>
                <DataGridCheckBoxColumn Header="IsFinished" Binding="{Binding IsFinished}"></DataGridCheckBoxColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
