<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="550" d:DesignHeight="350"
        MinHeight="350" MinWidth="550"
        MaxHeight="400" MaxWidth="650"
        Width="550" Height="350"
        x:Class="GameRandom.Views.ChooseGameWindow"
        Title="Choose Game">

        <DockPanel Classes="GameInfoContainer">

                <Grid Classes="GameInfoGrid" RowDefinitions="Auto, Auto, Auto, Auto, Auto" ColumnDefinitions="Auto, Auto">

                        <!-- Game name -->
                        <Border Grid.Row="0" Grid.Column="0" Classes="GameInfoItem">
                                <TextBlock Text="Name: " Classes="GameInfoText" x:Name="GameName"/>
                        </Border>

                        <!-- Game genres -->
                        <Border Grid.Row="1" Grid.Column="0" Classes="GameInfoItem">
                                <TextBlock Text="Genres: " Classes="GameInfoText" x:Name="GameGenres"/>
                        </Border>

                        <!-- Release date -->
                        <Border Grid.Row="2" Grid.Column="0" Classes="GameInfoItem">
                                <TextBlock Text="Release: " Classes="GameInfoText" x:Name="ReleaseDate"/>
                        </Border>

                        <!-- Game rating -->
                        <Border Grid.Row="3" Grid.Column="0" Classes="GameInfoItem">
                                <TextBlock Text="Rating: " Classes="GameInfoText" x:Name="GameRating"/>
                        </Border>

                        <!-- Game developers -->
                        <Border Grid.Row="4" Grid.Column="0" Classes="GameInfoItem">
                                <TextBlock Text="Developers: " Classes="GameInfoText" x:Name="GameDevelopers"/>
                        </Border>

                        <!-- Game cover image -->
                        
                </Grid>
                
                <Grid RowDefinitions="Auto, Auto" DockPanel.Dock="Left" HorizontalAlignment="Center"  VerticalAlignment="Center" RowSpacing="5">
                        <Border  Classes="GameImageBorder" Width="300" Height="150">
                                <Image Source="avares://GameRandom/Assets/steamAwatarWithNight.jpg" Stretch="UniformToFill" x:Name="GameHeader"/>
                        </Border>
                
                        <!-- Action buttons -->
                        <Border Grid.Row="1">
                                <Grid ColumnDefinitions="Auto, Auto" HorizontalAlignment="Center" ColumnSpacing="10">

                                        <Button Classes="GameInfoButton" Content="Steam" Click="ToSteamStorePage"></Button>

                                        <Button Grid.Column="1" Classes="GameInfoButton" Content="Choose Game" Click="ChooseGame"></Button>

                                </Grid>
                        </Border>
                </Grid>
                
               
        </DockPanel>
</Window>
