<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="300"
        x:Class="GameRandom.Views.ChooseGameWindow"
        Title="Choose Game">

        <DockPanel Width="400" Height="300" Classes="GameInfoContainer">

                <Grid Classes="GameInfoGrid" RowDefinitions="Auto, Auto, Auto, Auto, Auto" ColumnDefinitions="Auto, Auto">

                        <!-- Game name -->
                        <Border Grid.Row="0" Grid.Column="0" Classes="GameInfoItem">
                                <TextBlock Text="Name: " Classes="GameInfoText" x:Name="GameName"/>
                        </Border>

                        <!-- Game genres -->
                        <Border Grid.Row="1" Grid.Column="0" Classes="GameInfoItem">
                                <TextBlock Text="Genres: " Classes="GameInfoText" x:Name="GameGenres"/>
                        </Border>

                        <!-- Release date -->
                        <Border Grid.Row="2" Grid.Column="0" Classes="GameInfoItem">
                                <TextBlock Text="Release: " Classes="GameInfoText" x:Name="ReleaseDate"/>
                        </Border>

                        <!-- Game rating -->
                        <Border Grid.Row="3" Grid.Column="0" Classes="GameInfoItem">
                                <TextBlock Text="Rating: " Classes="GameInfoText" x:Name="GameRating"/>
                        </Border>

                        <!-- Game developers -->
                        <Border Grid.Row="4" Grid.Column="0" Classes="GameInfoItem">
                                <TextBlock Text="Developers: " Classes="GameInfoText" x:Name="GameDevelopers"/>
                        </Border>

                        <!-- Game cover image -->
                        <Border Grid.Row="0" Grid.Column="1" Grid.RowSpan="4" Classes="GameImageBorder" Width="140">
                                <Image Source="avares://GameRandom/Assets/steamAwatarWithNight.jpg" Stretch="UniformToFill"/>
                        </Border>

                        <!-- Action buttons -->
                        <Border Grid.Row="4" Grid.Column="1">
                                <Grid ColumnDefinitions="Auto, Auto">

                                        <Button Classes="GameInfoButton" Content="Steam"></Button>

                                        <Button Grid.Column="1" Classes="GameInfoButton" Content="Choose Game"></Button>

                                </Grid>
                        </Border>

                </Grid>
        </DockPanel>
</Window>
