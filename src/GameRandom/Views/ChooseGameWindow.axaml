<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:GameRandom.ViewModels.AdminConfirmSystem"
        xmlns:chooseGameSystem="clr-namespace:GameRandom.ViewModels.ChooseGameSystem"
        mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="400"
        Width="800" Height="400"
        MinWidth="700" MaxWidth="900"
        MinHeight="400" MaxHeight="400"
        x:Class="GameRandom.Views.ChooseGameWindow"
        x:DataType="chooseGameSystem:ChooseGameViewModel"
        Title="Choose Game">

    <!-- Main container for the choose game window -->
    <DockPanel Classes="WindowContainer ChooseGameWindowRoot">

        <Border DockPanel.Dock="Top" Classes="WindowTopContainer" Margin="5" CornerRadius="5">
            <Grid ColumnDefinitions="*, Auto">
                <TextBlock Text="Choose game" Classes="WindowTextBlock" FontSize="20"
                           HorizontalAlignment="Left" VerticalAlignment="Center"></TextBlock>

                <Button Grid.Column="1" Theme="{StaticResource DefaultButton}" Click="CloseWindow">Close</Button>
            </Grid>
        </Border>

        <!-- Main grid layout: left column for info, right column for image and actions -->
        <Grid Classes="WindowGrid" RowDefinitions="Auto, Auto, Auto, Auto, Auto" DockPanel.Dock="Left" Margin="5,0,0,20"
              VerticalAlignment="Center" HorizontalAlignment="Left">

            <!-- Game name -->
            <Border Grid.Row="0" Grid.Column="0" Classes="WindowTextBorder CurrentGameTextBorder">
                <TextBlock Text="{Binding AppInfo.AppData.AppName, StringFormat='Name: {0}',
                                      TargetNullValue='Name: Empty', FallbackValue='Failed to find app name'}"
                                     Classes="WindowTextBlock CurrentGameTextBlock" x:Name="GameName" />
            </Border>

            <!-- Game genres -->
            <Border Grid.Row="1" Grid.Column="0" Classes="WindowTextBorder CurrentGameTextBorder">
                <TextBlock Text="{Binding AppInfo.AppData.AppGenres,
                                  Converter={StaticResource ArrayTextJoinConverter}, ConverterParameter='Genres',
                                  FallbackValue='Genres not find'}"
                           Classes="WindowTextBlock CurrentGameTextBlock" x:Name="GameGenres" />
            </Border>

            <!-- Game categories -->
            <Border Grid.Row="2" Grid.Column="0" Classes="WindowTextBorder CurrentGameTextBorder">
                <TextBlock Text="{Binding AppInfo.AppData.AppCategories,
                                  Converter={StaticResource ArrayTextJoinConverter}, ConverterParameter='Categories',
                                  FallbackValue='Categories not find'}"
                           Classes="WindowTextBlock CurrentGameTextBlock" x:Name="GameCategories" />
            </Border>

            <!-- Release date -->
            <Border Grid.Row="3" Grid.Column="0" Classes="WindowTextBorder CurrentGameTextBorder">
                <TextBlock Text="{Binding AppInfo.AppData.AppReleaseYear, StringFormat='Release: {0}',
                                  TargetNullValue='Release is null', FallbackValue='Not find release'}"
                           Classes="WindowTextBlock CurrentGameTextBlock" x:Name="ReleaseDate" />
            </Border>
        </Grid>

        <Grid DockPanel.Dock="Right" RowDefinitions="Auto, Auto" HorizontalAlignment="Right" Margin="20,0,20,0"
              VerticalAlignment="Center" RowSpacing="5">

            <!-- Game image -->
            <Border Grid.Row="0" Grid.Column="0" Classes="WindowImageBorder">
                <Border>
                    <Image Source="{Binding AppInfo.ImageBytes, Converter={StaticResource ByteToImageConverter}}"
                           x:Name="GameHeader" Classes="WindowHeaderImage" />
                </Border>
            </Border>

            <!-- Action buttons panel -->
            <Border Grid.Row="1" Grid.Column="0" HorizontalAlignment="Center">
                <Grid ColumnDefinitions="*, *" ColumnSpacing="40">

                    <Button Classes="WindowButton" Content="Steam" Click="ToSteamStorePage" HorizontalAlignment="Stretch"></Button>

                    <Button Grid.Column="1" Classes="WindowButton" Content="Choose Game" Click="ChooseGame" HorizontalAlignment="Stretch"></Button>

                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>