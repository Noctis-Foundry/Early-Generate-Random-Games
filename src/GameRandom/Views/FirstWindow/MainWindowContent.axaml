<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600"
             MinHeight="460"
             x:Class="GameRandom.Views.MainWindowContent"
             xmlns:vm="using:GameRandom.ViewModels.MainWindowSystem"
             x:DataType="vm:MainWindowViewModel">
    
    <Grid Background="{StaticResource PaperLinearGradient}">
        <Grid Classes="MainGrid" ColumnDefinitions="*, *" RowDefinitions="*, *">
            <Button Classes="MainButton" Grid.Column="0" Grid.Row="0" Click="GoToTable">
                <Image Classes="MainImage" Source="avares://GameRandom/Assets/LeftUpClick.png"></Image>
            </Button>
            <Button Classes="MainButton" Grid.Column="0" Grid.Row="1" Click="GoToProfile">
                <Image Classes="MainImage" Source="avares://GameRandom/Assets/LeftDownClick.png"></Image>
            </Button>
            <Button Classes="MainButton" Grid.Column="1" Grid.Row="0" Grid.RowSpan="2" Click="GoToRollContent">
                <Image Classes="MainImage" Source="avares://GameRandom/Assets/RightClick.png"></Image>
            </Button>
        </Grid>
    </Grid>
</UserControl>
