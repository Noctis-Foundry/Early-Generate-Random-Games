<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GameRandom.ViewModels.AdminConfirmSystem"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:mainWindowSystem="clr-namespace:GameRandom.ViewModels.MainWindowSystem"
        xmlns:local="clr-namespace:GameRandom.Views"
        mc:Ignorable="d" d:DesignWidth="963" d:DesignHeight="700"
        x:Class="GameRandom.Views.MainWindowSystem.MainWindow"
        x:DataType="mainWindowSystem:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="GameRandom"
        Width="1000" Height="600"
        MinWidth="1000" MinHeight="500"
        MaxWidth="1920" MaxHeight="1080">
        
        <Window.Styles>
                <Style Selector="Border.MainTopContainer">
                        <Setter Property="Padding" Value="6"/>
                        <Setter Property="Background" Value="Transparent"/>
        
                        <!-- Border settings -->
                        <Setter Property="BorderBrush" Value="{StaticResource MangaLineColor}"/>
                        <Setter Property="BorderThickness" Value="2"/>
                        <Setter Property="CornerRadius" Value="0"></Setter>
                </Style>
        </Window.Styles>
        
        <DockPanel Background="{StaticResource PaperLinearGradient}">
                <Border x:Name="TopContainer" Classes="MainTopContainer" DockPanel.Dock="Top" Height="50" Margin="5,2,5,0">
                        <Grid ColumnDefinitions="Auto, *" Classes="MenuGrid" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <Grid ColumnDefinitions="*, *, *" Classes="ButtonGrid">
                                        <Button Classes="MenuButton" 
                                                Theme="{StaticResource DefaultButton}"
                                                Command="{Binding LobbyOpenCommand}">Lobby</Button>
                                        <Button Grid.Column="1" Classes="MenuButton" 
                                                Theme="{StaticResource DefaultButton}"
                                                Command="{Binding RulesOpenCommand}">Rules</Button>
                                        <Button Grid.Column="2" Classes="MenuButton"
                                                Theme="{StaticResource DefaultButton}"
                                                Command="{Binding AdminOpenCommand}">Admin</Button>
                                </Grid>
                                <Grid Grid.Column="1" Classes="MenuAvatarGrid" ColumnDefinitions="*" x:Name="LobbyImages">
                                        <Border Classes="MenuAvatarBorder">
                                                <Image Classes="MenuAvatar" Source="avares://GameRandom/Assets/steamAwatarWithNight.jpg"/>
                                        </Border>
                                </Grid>
                        </Grid>
                </Border>
                
                <!-- <ContentControl x:Name="ControlMain" Content="{Binding UserControlNavigate.ControlContent^}"  -->
                <!--                 ></ContentControl> -->
                
                
                <ContentControl x:Name="ControlMain" Content="{Binding UserControlNavigate.ControlContent^}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                VerticalAlignment="Stretch" VerticalContentAlignment="Stretch"
                                Margin="0,5,0,0"/>
        </DockPanel>
        
       
</Window>