<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="GameRandom.Views.MainWindowSystem.LoadControl">
    
    <DockPanel>
        <Grid RowDefinitions="Auto, Auto" HorizontalAlignment="Center"
              VerticalAlignment="Center" Background="Transparent" RowSpacing="10">
            <TextBlock Text="Loading..." FontSize="20" 
                       HorizontalAlignment="Center"></TextBlock>
            <ProgressBar x:Name="WaitBar" Grid.Row="1"></ProgressBar>
        </Grid>
    </DockPanel>
</UserControl>
