<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:rollGameViewModel="clr-namespace:GameRandom.ViewModels.RollGameViewModel"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="500"
             x:Class="GameRandom.Views.RollGame" x:DataType="rollGameViewModel:RollGameViewModel"
             MinWidth="1000" MinHeight="460">

    <DockPanel Classes="RollGameRoot">
        
        <Border Classes="HeaderBorder" DockPanel.Dock="Top" Margin="15,15,15,0" CornerRadius="15">
            <Grid ColumnDefinitions="*, Auto Auto" ColumnSpacing="10" Height="50">
                <Border HorizontalAlignment="Left" Margin="15,0,0,0">
                    <TextBlock Classes="HeaderText" Text="Game Randomizer" HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>

                <Button Grid.Column="1" Classes="ProfileButtons" Content="Filters" 
                        Foreground="White" HorizontalAlignment="Right" Width="100" HorizontalContentAlignment="Center" Height="35"
                        FontSize="20" Click="GoToFilter"></Button>
            
                <Button Grid.Column="2" Classes="CloseButton" MinWidth="60" MinHeight="35" MaxHeight="35" Margin="0,0,13,0"
                        Click="CloseUserControl" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                    ✕
                </Button>
            </Grid>
        </Border>
        

        <StackPanel HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                Margin="0,15,0,0">
            <Grid x:Name="GamesGrid" RowDefinitions="*, *" ColumnDefinitions="*, *, *" Margin="0,15,0,0"
                  HorizontalAlignment="Center" VerticalAlignment="Stretch" RowSpacing="10" ColumnSpacing="3">

                <Border Classes="GameBorder" Grid.Column="0">
                    <Button Classes="RandomButton" x:Name="AppButton1">
                        <Image Classes="GameImages" x:Name="AppImage1"
                               Source="avares://GameRandom/Assets/header.jpg" />
                    </Button>
                </Border>

                <Border Classes="GameBorder" Grid.Column="1" Grid.Row="0">
                    <Button Classes="RandomButton" x:Name="AppButton2">
                        <Image Classes="GameImages" x:Name="AppImage2"
                               Source="avares://GameRandom/Assets/header.jpg" />
                    </Button>
                </Border>

                <Border Classes="GameBorder" Grid.Column="2" Grid.Row="0">
                    <Button Classes="RandomButton" x:Name="AppButton3">
                        <Image Classes="GameImages" x:Name="AppImage3"
                               Source="avares://GameRandom/Assets/header.jpg" />
                    </Button>
                </Border>
                
                <Border Classes="GameBorder" Grid.Column="0" Grid.Row="1">
                    <Button Classes="RandomButton" x:Name="AppButton4">
                        <Image Classes="GameImages" x:Name="AppImage4"
                               Source="avares://GameRandom/Assets/header.jpg" />
                    </Button>
                </Border>
                
                <Border Classes="GameBorder" Grid.Column="2" Grid.Row="1" Grid.ColumnSpan="1">
                    <Button Classes="RandomButton" x:Name="AppButton5" >
                        <Image Classes="GameImages" x:Name="AppImage5"
                               Source="avares://GameRandom/Assets/header.jpg" />
                    </Button>
                </Border>
            </Grid>
            
            <Border Classes="ContentBorder" Margin="5" Padding="5">
                <Grid RowDefinitions="Auto" ColumnDefinitions="Auto, Auto, Auto, Auto" HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      ColumnSpacing="15">

                    <Button Classes="GenerateButton" Grid.Column="0" x:Name="GenerateButton"
                            Click="GenerateGame">
                        <TextBlock Classes="GenerateButtonText" Text="Search" />
                    </Button>

                    <Border Classes="InputBorder" Grid.Column="1">
                        <MaskedTextBox Classes="CountInput" x:Name="CountApp" Text="3"
                                       HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                    </Border>
                        
                    <CheckBox Grid.Column="2" Content="filter" Width="100" IsChecked="{Binding IsFilter}" x:Name="FilterCheckBox"></CheckBox>
                    <CheckBox Grid.Column="3" Content="User lib" Width="120" 
                              IsChecked="{Binding IsUserLib}" 
                              x:Name="FromUserLib"></CheckBox>
                </Grid>
            </Border>
        </StackPanel>
    </DockPanel>
</UserControl>