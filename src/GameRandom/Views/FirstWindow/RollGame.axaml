<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="using:GameRandom.ViewModels"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600"
             x:Class="GameRandom.Views.RollGame" x:DataType="vm:RollGameViewModel"
             Width="1000" Height="600">

    <DockPanel>
        <DockPanel.Background>
            <ImageBrush Source="avares://GameRandom/Assets/RandomGame.png" Stretch="Fill" />
        </DockPanel.Background>

        <Border Classes="HeaderBorder" DockPanel.Dock="Top" Margin="13">
            <Grid ColumnDefinitions="*, Auto Auto" ColumnSpacing="10">
                <Border HorizontalAlignment="Left" Margin="15,0,0,0">
                    <TextBlock Classes="HeaderText" Text="GAME RANDOMIZER" HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>

                <Button Grid.Column="1" Classes="ProfileButtons" Content="Filters" 
                        Foreground="White" HorizontalAlignment="Right" Width="100" HorizontalContentAlignment="Center" Height="40"
                        FontSize="20" Click="GoToFilter"></Button>
            
                <Button Grid.Column="2" Classes="CloseButton" MinWidth="60" MinHeight="60" Margin="0,0,13,0"
                        Click="Close" FontSize="36" HorizontalAlignment="Center" VerticalAlignment="Center">
                    ✕
                </Button>
            </Grid>
        </Border>
        

        <Border Classes="ContentBorder" HorizontalAlignment="Center" VerticalAlignment="Top"
                MinWidth="600" MaxWidth="800" MinHeight="280" MaxHeight="400"
                Margin="0,15,0,0">
            <Grid x:Name="GamesGrid" RowDefinitions="Auto, Auto" ColumnDefinitions="Auto, Auto, Auto"
                  HorizontalAlignment="Center" RowSpacing="10">

                <Border Classes="GameBorder" Grid.Column="0">
                    <Button Classes="RandomButton" x:Name="AppButton1">
                        <Image Classes="GameImages" x:Name="AppImage1"
                               Source="avares://GameRandom/Assets/avalonia-logo.ico" />
                    </Button>
                </Border>

                <Border Classes="GameBorder" Grid.Column="1" Grid.Row="0">
                    <Button Classes="RandomButton" x:Name="AppButton2">
                        <Image Classes="GameImages" x:Name="AppImage2"
                               Source="avares://GameRandom/Assets/avalonia-logo.ico" />
                    </Button>
                </Border>

                <Border Classes="GameBorder" Grid.Column="2" Grid.Row="0">
                    <Button Classes="RandomButton" x:Name="AppButton3">
                        <Image Classes="GameImages" x:Name="AppImage3"
                               Source="avares://GameRandom/Assets/avalonia-logo.ico" />
                    </Button>
                </Border>
                
                <Border Grid.Row="1" Grid.Column="1" Classes="ContentBorder" Height="80" Width="320">
                    <Grid RowDefinitions="Auto" ColumnDefinitions="Auto, Auto, Auto" HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          ColumnSpacing="15">

                        <Button Classes="GenerateButton" Grid.Column="0" x:Name="GenerateButton"
                                Click="GenerateGames">
                            <TextBlock Classes="GenerateButtonText" Text="Search" />
                        </Button>

                        <Border Classes="InputBorder" Grid.Column="1">
                            <MaskedTextBox Classes="CountInput" x:Name="CountApp" Text="3"
                                           HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                        </Border>
                        
                        <CheckBox Grid.Column="2" Content="filter" Width="100"></CheckBox>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </DockPanel>
</UserControl>