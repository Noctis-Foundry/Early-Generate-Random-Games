<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GameRandom.ViewModels"
        x:Class="GameRandom.Views.ProfileContent"
        x:DataType="vm:ProfileViewModel"
        MinWidth="1000" MinHeight="460">
    <DockPanel Classes="ProfileContentRoot">
        
        <Border DockPanel.Dock="Top" Classes="TopProfileContainer" 
                Height="60" Width="500" Margin="0,10,0,0" Padding="5">
            <Grid ColumnSpacing="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                    <ColumnDefinition Width="Auto"></ColumnDefinition>
                    <ColumnDefinition Width="Auto"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                
                <TextBlock x:Name="ProfileText" Text="Profile"
                           HorizontalAlignment="Left" VerticalAlignment="Center"></TextBlock>
                
                <Button Grid.Column="1" Classes="ProfileButtons" Click="OpenActivityGame">Activity game</Button>
                <Button Grid.Column="2" Classes="ProfileButtons" Click="CloseUserControl">Close</Button>
            </Grid>
        </Border>
        
        <Grid ColumnSpacing="10" Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            
            <ContentControl x:Name="StatisticContent"
                            Margin="0,15,0,0"
                            ></ContentControl>
            <Border Grid.Column="1" Width="250" MaxHeight="400" DockPanel.Dock="Top" Classes="AvatarContainer"
                    HorizontalAlignment="Right" VerticalAlignment="Stretch" Margin="0, 0,15,20">
                <Grid RowDefinitions="Auto, Auto" RowSpacing="15" VerticalAlignment="Top" Margin="10,10,0,0">
                    <Border Width="200" MaxHeight="200" ClipToBounds="True" Classes="AvatarContainer" CornerRadius="45" BorderThickness="2">
                        <Image Source="{Binding ProfileImage}"
                               x:Name="ProfileImage" Stretch="UniformToFill">
                            <Image.OpacityMask>
                                <VisualBrush>
                                    <VisualBrush.Visual>
                                        <Border Width="140" Height="140" CornerRadius="30" 
                                                Background="Black"></Border>
                                    </VisualBrush.Visual>
                                </VisualBrush>
                            </Image.OpacityMask>
                        </Image>
                    </Border>
                    
                    <Border Grid.Row="1" Classes="AvatarContainer" MaxHeight="150" MinWidth="150" MaxWidth="230"
                            HorizontalAlignment="Center" Padding="7" Margin="0,10,8,0" VerticalAlignment="Bottom">
                        <TextBlock Text="{Binding PlayerNickname}" x:Name="ProfileName" 
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Classes="ProfileNickname" >fdsafdsafdsafafdsafdsafdsaffdsafdsafdsaffdsafdsaf</TextBlock>
                    </Border>
                   
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>