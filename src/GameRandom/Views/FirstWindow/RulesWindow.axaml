<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             MinWidth="800" MaxWidth="1000"
             MinHeight="450" MaxHeight="650"
             x:Class="GameRandom.Views.RulesWindow">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock x:Name="TitleText"/>
            
            <Button x:Name="LanguageButton" Click="ToggleLanguage"/>
            
            <Button Click="Close">✕ CLOSE</Button>
        </StackPanel>

        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="15">

                <Border>
                    <TextBlock x:Name="Rule1Text"/>
                </Border>

                <Border>
                    <TextBlock x:Name="Rule2Text"/>
                </Border>

                <Border>
                    <TextBlock x:Name="Rule3Text"/>
                </Border>

                <Border>
                    <TextBlock x:Name="Rule4Text"/>
                </Border>

                <Border>
                    <TextBlock x:Name="Rule5Text"/>
                </Border>

                <Border>
                    <StackPanel Spacing="10">
                        <TextBlock x:Name="Rule6Text"/>
                        
                        <TextBlock x:Name="PricesTitleText"/>
                        
                        <StackPanel Spacing="6" Margin="10,0,0,0">
                            <TextBlock x:Name="Price1Text"/>
                            <TextBlock x:Name="Price2Text"/>
                            <TextBlock x:Name="Price3Text"/>
                            <TextBlock x:Name="Price4Text"/>
                            <TextBlock x:Name="Price5Text" FontWeight="SemiBold"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border>
                    <TextBlock x:Name="Rule7Text"/>
                </Border>

                <Border>
                    <TextBlock x:Name="Rule8Text"/>
                </Border>

                <Border>
                    <TextBlock x:Name="Rule9Text"/>
                </Border>

                <Border>
                    <TextBlock x:Name="Rule10Text"/>
                </Border>

            </StackPanel>
        </ScrollViewer>

    </Grid>
</UserControl>