<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:tablesSystem="clr-namespace:GameRandom.ViewModels.TablesSystem"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="460"
             MinHeight="460"
             x:Class="GameRandom.Views.GameTable"
             x:DataType="tablesSystem:GameTableViewModel">

    <DockPanel Classes="TableRootContainer GameTableRoot">

        <Border Classes="TableTopContainer" Theme="{StaticResource DefaultBorder}" DockPanel.Dock="Top">
            <Grid ColumnDefinitions="*, Auto">
                <TextBlock Text="Game table" Classes="TableTitleTextBoxStyle"/>
                <Button Grid.Column="1" Content="Close" Classes="TableButtons" Click="CloseUserControl"/>
            </Grid>
        </Border>

        <DataGrid Classes="TableDataGrid" ItemsSource="{Binding TableData}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="User" Binding="{Binding PlayerName, DataType=tablesSystem:GameTableData}"/>
                <DataGridTextColumn Header="Game" Binding="{Binding GameInfo.AppName, DataType=tablesSystem:GameTableData}"/>
                <DataGridTextColumn Header="Comment" Binding="{Binding GameInfo.Comment, DataType=tablesSystem:GameTableData}"/>
                <DataGridTextColumn Header="Begin date" Binding="{Binding GameInfo.BeginTime, DataType=tablesSystem:GameTableData}"/>
                <DataGridTextColumn Header="End date" Binding="{Binding GameInfo.EndTime, DataType=tablesSystem:GameTableData}"/>
                <DataGridTextColumn Header="Finished time" Binding="{Binding GameInfo.FinishTime, DataType=tablesSystem:GameTableData}"/>
            </DataGrid.Columns>
        </DataGrid>

    </DockPanel>
</UserControl>