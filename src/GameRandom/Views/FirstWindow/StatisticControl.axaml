<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:GameRandom.ViewModels.AdminConfirmSystem"
             xmlns:statisticSystem="clr-namespace:GameRandom.ViewModels.StatisticSystem"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="GameRandom.Views.StatisticControl"
             x:DataType="statisticSystem:StatisticViewModel">

    
    <Border Classes="StatisticContainer">
        <Grid RowDefinitions="Auto, Auto" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" RowSpacing="5" Margin="10">
            <Border Classes="StatisticHeader" Padding="5">
                <Grid ColumnDefinitions="*, Auto">
                    <TextBlock Text="Player Statistic"
                               Classes="StatisticHeaderText" VerticalAlignment="Center">
                    </TextBlock>

                    <Button Grid.Column="1" Classes="ProfileButtons"
                            HorizontalAlignment="Right" Click="OpenTable">
                        Games Table
                    </Button>
                </Grid>
            </Border>
        
            <Grid Grid.Row="1" RowDefinitions="Auto, Auto" ColumnDefinitions="Auto, Auto, Auto" Classes="CardContainer"
                  x:Name="StatisticCardGrid">
            </Grid>
        </Grid>
    </Border>

</UserControl>