<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GameRandom.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="850" d:DesignHeight="600"
             x:Class="GameRandom.Views.CreateLobby"
             x:DataType="vm:CreateLobbyViewModel"
             MaxHeight="600" MaxWidth="600">
    <DockPanel>
        <Grid Background="Black">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
            <TextBlock Text="CHALLENGE RULES" 
                       FontSize="24" 
                       FontWeight="Bold" 
                       Foreground="White"
                       HorizontalAlignment="Center"
                       Margin="0,20,0,10"
                       TextDecorations="Underline"/>
            
      
        <!-- Прокручиваемая область с правилами -->
        <ScrollViewer Grid.Row="1" 
                      VerticalScrollBarVisibility="Auto" 
                      HorizontalScrollBarVisibility="Disabled"
                      Margin="20,0,20,20">
            <StackPanel Spacing="15">

                <!-- Правило 1 -->
                <Border BorderBrush="White" BorderThickness="1" Padding="15" Background="#111111">
                    <TextBlock Text="1. The initial number of game rolls is 3, but this number may vary according to other rules" 
                               Foreground="White" 
                               FontSize="14" 
                               TextWrapping="Wrap"/>
                </Border>

                <!-- Правило 2 -->
                <Border BorderBrush="White" BorderThickness="1" Padding="15" Background="#111111">
                    <TextBlock Text="2. If a player completes a game faster than the allotted time (time can be checked on Cubiq.ru), one additional roll is added." 
                               Foreground="White" 
                               FontSize="14" 
                               TextWrapping="Wrap"/>
                </Border>

                <!-- Правило 3 -->
                <Border BorderBrush="White" BorderThickness="1" Padding="15" Background="#111111">
                    <TextBlock Text="3. All games are played on maximum difficulty, hardcore mode with one life adds one more roll when completed." 
                               Foreground="White" 
                               FontSize="14" 
                               TextWrapping="Wrap"/>
                </Border>

                <!-- Правило 4 -->
                <Border BorderBrush="White" BorderThickness="1" Padding="15" Background="#111111">
                    <TextBlock Text="4. If a player cannot complete the game on maximum difficulty, there is an option to lower the difficulty with the condition that one roll will be removed" 
                               Foreground="White" 
                               FontSize="14" 
                               TextWrapping="Wrap"/>
                </Border>

                <!-- Правило 5 -->
                <Border BorderBrush="White" BorderThickness="1" Padding="15" Background="#111111">
                    <TextBlock Text="5. If a multiplayer game drops, the player needs to play it for 5 hours, in this case you can take someone to play with you, considering that the money for completing the game will be divided among people" 
                               Foreground="White" 
                               FontSize="14" 
                               TextWrapping="Wrap"/>
                </Border>

                <!-- Правило 6 и цены -->
                <Border BorderBrush="White" BorderThickness="1" Padding="15" Background="#111111">
                    <StackPanel Spacing="10">
                        <TextBlock Text="6. How payment will be processed: each game has a cost, payment occurs after completing the game" 
                                   Foreground="White" 
                                   FontSize="14" 
                                   TextWrapping="Wrap"/>
                        
                        <TextBlock Text="Prices for completing games:" 
                                   Foreground="White" 
                                   FontSize="14" 
                                   FontWeight="Bold"
                                   Margin="0,10,0,5"/>
                        
                        <StackPanel Spacing="6" Margin="10,0,0,0">
                            <TextBlock Text="• Game from 1-5 hours: 150 rubles" Foreground="White" FontSize="13"/>
                            <TextBlock Text="• Game from 5-10 hours: 250 rubles" Foreground="White" FontSize="13"/>
                            <TextBlock Text="• Game from 10-25 hours: 500 rubles" Foreground="White" FontSize="13"/>
                            <TextBlock Text="• Game from 25 hours and above: 1000 rubles" Foreground="White" FontSize="13"/>
                            <TextBlock Text="• Game completed 100%: the full amount of the game is paid to the user" 
                                       Foreground="White" 
                                       FontSize="13"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Правило 7 -->
                <Border BorderBrush="White" BorderThickness="1" Padding="15" Background="#111111">
                    <TextBlock Text="7. When dropping a game, this money is paid not to you but to the common bank, the bank will be 50,000 rubles, from this bank you can take money when completing games, and also replenish it when violating rules (for example, you dropped a game for 150, you put this money in the bank, you can immediately roll another game and try to take this money)" 
                               Foreground="White" 
                               FontSize="14" 
                               TextWrapping="Wrap"/>
                </Border>

                <!-- Правило 8 -->
                <Border BorderBrush="White" BorderThickness="1" Padding="15" Background="#111111">
                    <TextBlock Text="8. When dropping a game, you get minus one roll and randomly select a year" 
                               Foreground="White" 
                               FontSize="14" 
                               TextWrapping="Wrap"/>
                </Border>

                <!-- Правило 9 -->
                <Border BorderBrush="White" BorderThickness="1" Padding="15" Background="#111111">
                    <TextBlock Text="9. Watching a speedrun for faster completion minus one roll and will not add a roll from rule 2" 
                               Foreground="White" 
                               FontSize="14" 
                               TextWrapping="Wrap"/>
                </Border>

                <!-- Правило 10 -->
                <Border BorderBrush="White" BorderThickness="1" Padding="15" Background="#111111">
                    <TextBlock Text="10. If a game was completed earlier in this challenge, it can be rerolled, previous completions from the first part do not count" 
                               Foreground="White" 
                               FontSize="14" 
                               TextWrapping="Wrap"/>
                </Border>

            </StackPanel>
        </ScrollViewer>

    </Grid>
        
    </DockPanel>
</UserControl>
