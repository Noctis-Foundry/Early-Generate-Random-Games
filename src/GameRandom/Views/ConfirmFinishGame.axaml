<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:GameRandom.ViewModels.AdminConfirmSystem"
        xmlns:confirmFinishGameSystem="clr-namespace:GameRandom.ViewModels.ConfirmFinishGameSystem"
        mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="400"
        x:Class="GameRandom.Views.ConfirmFinishGame"
        x:DataType="confirmFinishGameSystem:ConfirmFinishGameViewModel"
        Title="Confirm Finish Game"
        Width="800" Height="400"
        MinWidth="700" MaxWidth="900"
        MinHeight="400" MaxHeight="400"
        CanResize="True">

    <Design.DataContext>
        <confirmFinishGameSystem:ConfirmFinishGameViewModel />
    </Design.DataContext>

    <!-- Main container for the confirm finish game window -->
    <DockPanel Classes="WindowContainer ConfirmFinishGameRoot">

        <Border DockPanel.Dock="Top" Classes="WindowTopContainer" Margin="5" CornerRadius="5">
            <Grid ColumnDefinitions="*, Auto">
                <TextBlock Text="Finish Game" Classes="WindowTextBlock" FontSize="20"
                           HorizontalAlignment="Left" VerticalAlignment="Center"></TextBlock>

                <Button Grid.Column="1" Theme="{StaticResource DefaultButton}" Click="CloseWindow">Close</Button>
            </Grid>
        </Border>

        <!-- Main grid layout: left column for info + comment, right column for image and actions -->
        <Grid Classes="WindowGrid" RowDefinitions="Auto, Auto, Auto, Auto, Auto" DockPanel.Dock="Left" Margin="5,0,0,20"
              VerticalAlignment="Center" HorizontalAlignment="Left" RowSpacing="10">

            <!-- Game name -->
            <Border Grid.Row="0" Grid.Column="0" Classes="WindowTextBorder CurrentGameTextBorder">
                <TextBlock Text="{Binding GameProgress.AppName, StringFormat='Name: {0}',
                                  TargetNullValue='Name: Empty', FallbackValue='Failed to find app name'}"
                           Classes="WindowTextBlock CurrentGameTextBlock" x:Name="GameName" />
            </Border>

            <!-- Comment TextBox -->
            <Border Grid.Row="1" Grid.Column="0" Classes="WindowTextBorder CurrentGameTextBorder">
                <TextBox MinHeight="30" MaxHeight="60" TextWrapping="Wrap" AcceptsReturn="True"
                         Watermark="Write comment..." Margin="10" MaxWidth="260" MinWidth="260" FontSize="12"
                         x:Name="CommentBox" />
            </Border>
        </Grid>

        <Grid DockPanel.Dock="Right" RowDefinitions="Auto, Auto" HorizontalAlignment="Right" Margin="20,0,20,0"
              VerticalAlignment="Center" RowSpacing="5">

            <!-- Image -->
            <Border Grid.Row="0" Grid.Column="0" Classes="WindowImageBorder" MinHeight="200">
                <Border>
                    <Image Source="{Binding ImageBitmap}" x:Name="GameImage" Classes="WindowHeaderImage" />
                </Border>
            </Border>

            <!-- Action buttons panel -->
            <Border Grid.Row="1" Grid.Column="0" HorizontalAlignment="Center">
                <Grid ColumnDefinitions="Auto, Auto, Auto" ColumnSpacing="10">
                    <Button Classes="WindowButton" Grid.Column="0" Content="Choose file"
                            Click="ChooseImageFromFile" HorizontalAlignment="Stretch"/>
                    <Button Classes="WindowButton" Grid.Column="1" Content="Paste"
                            Click="ChooseImageFromClipboard" HorizontalAlignment="Stretch" />
                    <Button Classes="WindowButton" Grid.Column="2" Content="Save Edit" Padding="10"
                            Click="OnSaveEditClick" HorizontalAlignment="Stretch" />
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>