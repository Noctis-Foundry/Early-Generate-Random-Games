<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="350" d:DesignHeight="150"
        MinHeight="150" MaxHeight="150"
        MinWidth="350" MaxWidth="350"
        x:Class="GameRandom.Views.TaskLoading"
        Title="TaskLoading">

    <DockPanel Classes="WindowContainer">
        <Grid Classes="WindowGrid">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="15">
                <Border Classes="WindowTextBorder">
                    <TextBlock Classes="WindowTextBlock" Text="Please wait" FontSize="14" />
                </Border>

                <ProgressBar Classes="LoadingProgress" IsIndeterminate="True" x:Name="WaitBar" Width="300" />
            </StackPanel>
        </Grid>
    </DockPanel>

</Window>