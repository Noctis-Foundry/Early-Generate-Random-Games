<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             x:Class="GameRandom.Views.AdminPanel"
             Width="1000" Height="460"
             MinWidth="1000" MinHeight="460"
             MaxWidth="1000" MaxHeight="460">
    
    <UserControl.Styles>
        <StyleInclude Source="/Styles/AdminPanelStyle.axaml"/>
    </UserControl.Styles>
    
    <Grid>
        <Grid.Background>
            <ImageBrush Source="avares://GameRandom/Assets/AppBackground.png" Stretch="Fill"></ImageBrush>
        </Grid.Background>
        
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <TextBlock Grid.Row="0" 
                   Text="Completed Games Awaiting Confirmation"
                   Classes="RatingTitle"
                   Margin="0,20,0,20"/>
        
        <DataGrid Grid.Row="1"
                  Classes="AdminDataGrid"
                  Margin="20"
                  GridLinesVisibility="All"
                  IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Player" Width="150"/>
                <DataGridTextColumn Header="Game" Width="*"/>
                <DataGridTextColumn Header="Completed Date" Width="150"/>
                <DataGridTextColumn Header="Status" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>
        
        <!-- Rating Dialog Overlay -->
        <Border Grid.Row="0" Grid.RowSpan="2"
                Classes="RatingDialog"
                Width="400"
                Height="350"
                IsVisible="False"
                x:Name="RatingDialog">
            <StackPanel>
                <TextBlock Classes="RatingTitle" Text="Rate Game Completion"/>
                
                <TextBlock Classes="RatingLabel" Text="Player:"/>
                <TextBlock Foreground="White" Margin="0,0,0,10"/>
                
                <TextBlock Classes="RatingLabel" Text="Game:"/>
                <TextBlock Foreground="White" Margin="0,0,0,10"/>
                
                <TextBlock Classes="RatingLabel" Text="Rating (1-10):"/>
                <NumericUpDown Classes="RatingInput"/>
                
                <TextBlock Classes="RatingLabel" Text="Comments:"/>
                <TextBox Height="80" 
                         AcceptsReturn="True" 
                         TextWrapping="Wrap"
                         Margin="0,5,0,20"/>
                
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Classes="RatingButton" Content="Confirm"/>
                    <Button Classes="RatingButton" Content="Reject"/>
                    <Button Classes="RatingButton" Content="Cancel"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
