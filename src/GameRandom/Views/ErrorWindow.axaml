<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="300"
        x:Class="GameRandom.Views.ErrorWindow"
        Width="500" Height="150"
        MaxWidth="500" MaxHeight="150"
        Title="ErrorWindow">
    
    <DockPanel>
        <DockPanel.Background>Gray</DockPanel.Background>
        
        <Grid RowDefinitions="Auto, Auto" RowSpacing="40"
              HorizontalAlignment="Center" VerticalAlignment="Center">
            <Label Classes="LobbyLabel"
                   FontSize="16">
                <TextBlock TextWrapping="Wrap" x:Name="ErrorLabel" Foreground="White" Text="Error"></TextBlock>
            </Label>
            <Button Grid.Row="1" Click="MessageBoxButtonAction" 
                    x:Name="ErrorButton" Content="Ok" HorizontalAlignment="Center"
                    Background="Black" Foreground="White" FontSize="16"
                    Width="100" HorizontalContentAlignment="Center"></Button>
        </Grid>
    </DockPanel>
</Window>
