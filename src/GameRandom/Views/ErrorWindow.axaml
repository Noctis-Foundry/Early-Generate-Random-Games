<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="GameRandom.Views.ErrorWindow"
        MinWidth="450" MaxWidth="450"
        MinHeight="250" MaxHeight="250"
        Title="Error">
    
    <DockPanel>
        <Grid RowDefinitions="*, Auto">
            
            <Border Grid.Row="0" MinWidth="400" MaxWidth="400" MinHeight="60" MaxHeight="80">
                <SelectableTextBlock x:Name="ErrorLabel" Text="fdsaaaaaaadsaffffffffffffdsfaaaaaaa"/>
            </Border>
            
            <Button Grid.Row="1" Click="MessageBoxButtonAction" x:Name="ErrorButton" 
                    Content="Ok" HorizontalAlignment="Center"/>
        </Grid>
        
    </DockPanel>
</Window>
