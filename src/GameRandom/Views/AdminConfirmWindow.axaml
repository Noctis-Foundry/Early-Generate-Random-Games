<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:GameRandom.ViewModels.AdminConfirmSystem"
        mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="400"
        Width="800" Height="400"
        MinWidth="700" MaxWidth="850"
        MinHeight="400" MaxHeight="400"
        x:Class="GameRandom.Views.AdminConfirmWindow"
        x:DataType="vm:AdminConfirmViewModel"
        Title="Confirm Game">

    <!-- Main container for the admin confirm window -->
    <DockPanel Classes="WindowContainer AdminConfirmWindowRoot">

        <Border DockPanel.Dock="Top" Classes="WindowTopContainer" Margin="5" CornerRadius="5">
            <Grid ColumnDefinitions="*, Auto">
                <TextBlock Text="Confirm Game" Classes="WindowTextBlock" FontSize="20"
                           HorizontalAlignment="Left" VerticalAlignment="Center"></TextBlock>

                <Button Grid.Column="1" Theme="{StaticResource DefaultButton}" Click="CloseWindow">Close</Button>
            </Grid>
        </Border>

        <!-- Main grid layout: left column for info, right column for image and actions -->
        <Grid Classes="WindowGrid" RowDefinitions="Auto, Auto, Auto, Auto, Auto" DockPanel.Dock="Left" Margin="5,0,0,20"
              VerticalAlignment="Center" HorizontalAlignment="Left">

            <!-- Player name -->
            <Border Grid.Row="0" Grid.Column="0" Classes="WindowTextBorder CurrentGameTextBorder">
                <TextBlock Classes="WindowTextBlock CurrentGameTextBlock" x:Name="PlayerName"
                           Text="{Binding NickName, StringFormat='Player: {0}',
                                  TargetNullValue='Player: Empty', FallbackValue='Failed to find player name'}" />
            </Border>

            <!-- Game name -->
            <Border Grid.Row="1" Grid.Column="0" Classes="WindowTextBorder CurrentGameTextBorder">
                <TextBlock Classes="WindowTextBlock CurrentGameTextBlock" x:Name="GameName"
                           Text="{Binding FinishedGame.GameProgresses.AppName, StringFormat='Name: {0}',
                                  TargetNullValue='Name: Empty', FallbackValue='Failed to find game name'}" />
            </Border>

            <!-- Completed date -->
            <Border Grid.Row="2" Grid.Column="0" Classes="WindowTextBorder CurrentGameTextBorder">
                <TextBlock Classes="WindowTextBlock CurrentGameTextBlock" x:Name="CompletedDate"
                           Text="{Binding FinishedGame.GameProgresses.EndTime,
                                  Converter={StaticResource TimeSpanConverter}, ConverterParameter='End date',
                                  FallbackValue='Game progresses is null'}" />
            </Border>
        </Grid>

        <Grid DockPanel.Dock="Right" RowDefinitions="Auto, Auto" HorizontalAlignment="Right" Margin="20,0,20,0"
              VerticalAlignment="Center" RowSpacing="5">

            <!-- Game image -->
            <Border Grid.Row="0" Grid.Column="0" Classes="WindowImageBorder">
                <Border>
                    <Image Classes="WindowHeaderImage" x:Name="GameImage"
                           Source="{Binding FinishedGame.ScreenShot, Converter={StaticResource ByteToImageConverter}}" />
                </Border>
            </Border>

            <!-- Action buttons panel -->
            <Border Grid.Row="1" Grid.Column="0" HorizontalAlignment="Center">
                <Grid ColumnDefinitions="*, *" ColumnSpacing="40">
                    <Button Classes="WindowButton" Content="Confirm" Click="ConfirmGame"
                            HorizontalAlignment="Stretch" />
                    <Button Grid.Column="1" Classes="WindowButton" Content="Reject" Click="RejectGame"
                            HorizontalAlignment="Stretch" />
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>