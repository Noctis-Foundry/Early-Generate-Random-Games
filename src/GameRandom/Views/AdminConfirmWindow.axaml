<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:GameRandom.ViewModels.AdminConfirmSystem"
        mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="400"
        MinWidth="700" MaxWidth="700"
        MinHeight="400" MaxHeight="400"
        x:Class="GameRandom.Views.AdminConfirmWindow"
        x:DataType="vm:AdminConfirmViewModel"
        Title="Confirm Game">
    
    <DockPanel Classes="WindowContainer">
        
        <Border DockPanel.Dock="Top" Classes="WindowTopContainer">
            <TextBlock Text="Confirm Game" Classes="WindowTextBlock" HorizontalAlignment="Center"/>
        </Border>
        
        <Grid Classes="WindowGrid" RowDefinitions="Auto, Auto, Auto" Width="300">
            
            <Border Grid.Row="0" Grid.Column="0" Classes="WindowTextBorder">
                <TextBlock Classes="WindowTextBlock" x:Name="PlayerName" Text="{Binding NickName}"/>
            </Border>
            
            <Border Grid.Row="1" Grid.Column="0" Classes="WindowTextBorder">
                <TextBlock Classes="WindowTextBlock" x:Name="GameName" 
                           Text="{Binding FinishedGame.GameProgresses.AppName, FallbackValue='Failed to find game name in the property'}"/>
            </Border>
            
            <Border Grid.Row="2" Grid.Column="0" Classes="WindowTextBorder">
                <TextBlock Classes="WindowTextBlock" x:Name="CompletedDate" 
                           Text="{Binding FinishedGame.GameProgresses.EndTime, Converter={StaticResource TimeSpanConverter}, ConverterParameter='End date: ',
                           FallbackValue='Game progresses is null'}"/>
            </Border>
            
        </Grid>
        
        <Grid RowDefinitions="Auto, Auto" DockPanel.Dock="Left" HorizontalAlignment="Center" VerticalAlignment="Center" RowSpacing="5">
            
            <Border Classes="WindowImageBorder">
                <Image Classes="WindowHeaderImage" x:Name="GameImage"
                       Source="{Binding FinishedGame.ScreenShot, Converter={StaticResource ByteToImageConverter}}"/>
            </Border>
            
            <Border Grid.Row="1">
                <Grid ColumnDefinitions="Auto, Auto" HorizontalAlignment="Center" ColumnSpacing="10">
                    <Button Classes="WindowButton" Content="Confirm" Click="ConfirmGame"/>
                    <Button Grid.Column="1" Classes="WindowButton" Content="Reject" Click="RejectGame"/>
                </Grid>
            </Border>
            
        </Grid>
        
    </DockPanel>
</Window>
