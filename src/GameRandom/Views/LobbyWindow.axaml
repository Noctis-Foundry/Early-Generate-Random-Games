<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:lobbySystem="clr-namespace:GameRandom.ViewModels.LobbySystem"
        mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="400"
        x:Class="GameRandom.Views.LobbyWindow"
        x:DataType="lobbySystem:LobbyWindowViewModel"
        Width="800" Height="400"
        MinWidth="800" MaxWidth="800"
        MinHeight="400" MaxHeight="400"
        Title="LOBBY CONNECTION"
        WindowStartupLocation="CenterScreen">
    
    <DockPanel Classes="WindowContainer LobbyWindowRoot">
        
        <Border DockPanel.Dock="Top" Classes="WindowTopContainer" MinWidth="250" Margin="5, 10">
            <Grid ColumnDefinitions="*, Auto">
                <TextBlock Text="Lobby Manager" HorizontalAlignment="Stretch" VerticalAlignment="Center" Classes="WindowTextBlock" FontSize="16"/>
                <Button Grid.Column="1" Classes="WindowButton" Click="CloseWindow">Close</Button>
            </Grid>
        </Border>

        <Grid Classes="WindowGrid" RowDefinitions="Auto, Auto" ColumnDefinitions="*, *" ColumnSpacing="30" HorizontalAlignment="Center" VerticalAlignment="Bottom"
        
              MinWidth="650" MinHeight="250" Margin="0,0,0,50">
            
            <!-- Lobby ID display -->
            <Border Grid.Column="0" Classes="WindowTextBorder" MaxHeight="200" Margin="5,0,0,0">
                <Grid RowDefinitions="*, *, *" RowSpacing="15">
                    <Border Classes="WindowTopContainer" MinWidth="350" HorizontalAlignment="Center" VerticalAlignment="Top">
                        <TextBlock Text="Create lobby" Classes="WindowTextBlock" FontSize="18"/>
                    </Border>
                    
                    <Border Grid.Row="1" Classes="WindowTextBorder" MinWidth="260" MaxWidth="260" VerticalAlignment="Center" HorizontalAlignment="Center"
                            MinHeight="50" MaxHeight="80">
                        <SelectableTextBlock Text="{Binding CurrentLobbyID, Converter='{StaticResource LongToStringConverter}',
                        ConverterParameter='Lobby ID'}" 
                                   Classes="WindowTextBlock" FontSize="14" TextWrapping="Wrap" FontFamily="{StaticResource 'Anime Ace'}" x:Name="LobbyId"/>
                    </Border>
                   
                    <Button Grid.Row="2" Content="Create Lobby" Click="Create" Classes="WindowButton" HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
                </Grid>
               
            </Border>

            <!-- Connect section -->
            <Border Grid.Row="0" Grid.Column="1" Classes="WindowTextBorder" MaxHeight="200" Margin="0,0,5,0">
                <Grid RowDefinitions="Auto, Auto, Auto" RowSpacing="15">
                    
                    <Border Grid.Row="0" VerticalAlignment="Center" Classes="WindowTopContainer" MinWidth="350">
                        <TextBlock Text="Connect ot lobby" Classes="WindowTextBlock" FontSize="18"/>
                    </Border>
                    
                    <TextBox Grid.Row="1" Classes="LobbyIdInput" x:Name="IdBox" MaxLength="20" Text="..." VerticalAlignment="Center" MinWidth="260" MaxWidth="260" MinHeight="50" MaxHeight="80" 
                             Watermark="Enter lobby ID"/>
                    <Button Grid.Row="2" Content="Connect" Click="Connect" Classes="WindowButton" HorizontalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Placeholder -->
            <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Classes="WindowTopContainer" Margin="10">
                <Grid ColumnDefinitions="Auto, Auto" ColumnSpacing="25">
                    <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" Classes="WindowTextBlock">Current Lobby members:</TextBlock> 
                    
                    <Grid Grid.Column="1" x:Name="LobbyAvatarGrid" ColumnDefinitions="Auto, Auto">
                        <Border Classes="MenuAvatarBorder">
                            <Image Classes="MenuAvatar" Source="avares://GameRandom/Assets/steamAwatarWithNight.jpg"/>
                        </Border>
                    </Grid>
                </Grid>
                
            </Border>
        </Grid>

    </DockPanel>
</Window>