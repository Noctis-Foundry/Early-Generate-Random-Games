<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:lobbySystem="clr-namespace:GameRandom.ViewModels.LobbySystem"
        mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="400"
        x:Class="GameRandom.Views.LobbyWindow"
        x:DataType="lobbySystem:LobbyWindowViewModel"
        MinWidth="700" MaxWidth="700"
        MinHeight="400" MaxHeight="400"
        Title="LOBBY CONNECTION"
        WindowStartupLocation="CenterScreen">
    
    <DockPanel Classes="WindowContainer LobbyWindowRoot">
        
        <Border DockPanel.Dock="Top" Classes="WindowTopContainer" MinWidth="250" Margin="0,10,0,0">
            <TextBlock Text="Lobby Manager" Classes="WindowTextBlock" FontSize="16"/>
        </Border>

        <Grid Classes="WindowGrid" RowDefinitions="*, *" ColumnDefinitions="*, *" ColumnSpacing="30"
              MinWidth="650" MinHeight="250" Margin="0,0,0,50">
            
            <Border DockPanel.Dock="Top" Classes="WindowTopContainer" MinWidth="250">
                <TextBlock Text="Create lobby" Classes="WindowTextBlock" FontSize="16"/>
            </Border>
            
            <Border Grid.Row="0" Grid.Column="1" DockPanel.Dock="Top" Classes="WindowTopContainer" MinWidth="250">
                <TextBlock Text="Connect ot lobby" Classes="WindowTextBlock" FontSize="16"/>
            </Border>
            
            <!-- Lobby ID display -->
            <Border Grid.Row="1" Grid.Column="0" Classes="WindowTextBorder" MinHeight="170" MaxHeight="180">
                <Grid RowDefinitions="Auto, Auto" HorizontalAlignment="Center" VerticalAlignment="Center" RowSpacing="15">
                    <Border Classes="WindowTextBorder" MinWidth="260" MaxWidth="260"
                            MinHeight="50" MaxHeight="80">
                        <SelectableTextBlock Text="{Binding CurrentLobbyID, Converter='{StaticResource LongToStringConverter}',
                        ConverterParameter='Lobby ID'}" 
                                   Classes="WindowTextBlock" x:Name="LobbyId"/>
                    </Border>
                   
                    <Button Grid.Row="1" Content="Create Lobby" Click="Create" Classes="WindowButton" HorizontalAlignment="Center"/>
                </Grid>
               
            </Border>

            <!-- Connect section -->
            <Border Grid.Row="1" Grid.Column="1" Classes="WindowTextBorder" MinHeight="170" MaxHeight="180">
                <Grid RowDefinitions="Auto, Auto" HorizontalAlignment="Center" VerticalAlignment="Center" RowSpacing="15">
                    <TextBox Classes="LobbyIdInput" x:Name="IdBox" MaxLength="20" Text="..." MinWidth="260" MaxWidth="260" MinHeight="40" MaxHeight="50" 
                             Watermark="Enter lobby ID"/>
                    <Button Grid.Row="1" Content="Connect" Click="Connect" Classes="WindowButton" HorizontalAlignment="Center"/>
                </Grid>
            </Border>

        </Grid>

    </DockPanel>
</Window>