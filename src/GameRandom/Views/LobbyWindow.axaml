<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GameRandom.ViewModels.AdminConfirmSystem"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:lobbySystem="clr-namespace:GameRandom.ViewModels.LobbySystem"
        mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="400"
        x:Class="GameRandom.Views.LobbyWindow"
        x:DataType="lobbySystem:LobbyWindowViewModel"
        MinWidth="700" MaxWidth="700"
        MinHeight="400" MaxHeight="400"
        Title="LOBBY CONNECTION"
        WindowStartupLocation="CenterScreen">
    
    <Window.Resources>
        <ImageBrush Source="avares://GameRandom/Assets/BaseWindowAssets/TextBlockBorder.png" 
                    Stretch="Fill" x:Key="TextBrush"></ImageBrush>
    </Window.Resources>
    
    <Window.Styles>
        <Style Selector="TextBox">
            <Setter Property="Background" Value="{StaticResource TextBrush}"> </Setter>
            <Setter Property="BorderThickness" Value="0"></Setter>
            <Setter Property="Foreground" Value="White"></Setter>
            <Setter Property="HorizontalContentAlignment" Value="Left"></Setter>
            <Setter Property="VerticalContentAlignment" Value="Center"></Setter>
            <Setter Property="Padding" Value="20,0,0,10"></Setter>
            <Setter Property="FontSize" Value="16"></Setter>
        </Style>
        
        <Style Selector="TextBox:pointerover">
            <Setter Property="Foreground" Value="DarkSeaGreen"></Setter>
            
            <Style Selector="^/template/ Border#PART_BorderElement">
                <Setter Property="Background" Value="{StaticResource TextBrush}"> </Setter>
                <Setter Property="BorderBrush" Value="#bb9e67"></Setter>
                <Setter Property="BorderThickness" Value="2"></Setter>
            </Style>
        </Style>
        
        <Style Selector="TextBox:focus">
            <Setter Property="Foreground" Value="DarkGoldenrod"></Setter>
            
            <Style Selector="^/template/ Border#PART_BorderElement">
                <Setter Property="Background" Value="{StaticResource TextBrush}"> </Setter>
                <Setter Property="BorderBrush" Value="#bb9e67"></Setter>
                <Setter Property="BorderThickness" Value="2"></Setter>
            </Style>
        </Style>
    </Window.Styles>
    
    <DockPanel>
        
        <Border DockPanel.Dock="Top" MinWidth="250" Margin="0,10,0,0">
            <TextBlock Text="Lobby Manager" FontSize="16"/>
        </Border>

        <Grid RowDefinitions="*, *" ColumnDefinitions="*, *" ColumnSpacing="30"
              MinWidth="650" MinHeight="250" Margin="0,0,0,50">
            
            <Border DockPanel.Dock="Top" MinWidth="250">
                <TextBlock Text="Create lobby" FontSize="16"/>
            </Border>
            
            <Border Grid.Row="0" Grid.Column="1" DockPanel.Dock="Top" MinWidth="250">
                <TextBlock Text="Connect ot lobby" FontSize="16"/>
            </Border>
            
            <!-- Lobby ID display -->
            <Border Grid.Row="1" Grid.Column="0" MinHeight="170" MaxHeight="180">
                <Grid RowDefinitions="Auto, Auto" HorizontalAlignment="Center" VerticalAlignment="Center" RowSpacing="15">
                    <Border MinWidth="260" MaxWidth="260"
                            MinHeight="50" MaxHeight="80">
                        <SelectableTextBlock Text="{Binding CurrentLobbyID, Converter='{StaticResource LongToStringConverter}',
                        ConverterParameter='Lobby ID'}" 
                                   x:Name="LobbyId"/>
                    </Border>
                   
                    <Button Grid.Row="1" Content="Create Lobby" Click="Create" HorizontalAlignment="Center"/>
                </Grid>
               
            </Border>

            <!-- Connect section -->
            <Border Grid.Row="1" Grid.Column="1" MinHeight="170" MaxHeight="180">
                <Grid RowDefinitions="Auto, Auto" HorizontalAlignment="Center" VerticalAlignment="Center" RowSpacing="15">
                    <TextBox x:Name="IdBox" MaxLength="20" Text="..." MinWidth="260" MaxWidth="260" MinHeight="40" MaxHeight="50" 
                             Watermark="Enter lobby ID"/>
                    <Button Grid.Row="1" Content="Connect" Click="Connect" HorizontalAlignment="Center"/>
                </Grid>
            </Border>

        </Grid>

    </DockPanel>
</Window>