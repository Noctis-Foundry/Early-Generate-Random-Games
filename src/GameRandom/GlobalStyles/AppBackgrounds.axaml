<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Design.PreviewWith>
        <Border Padding="20">
            <DockPanel>
                
            </DockPanel>
        </Border>
    </Design.PreviewWith>

    <Style Selector="DockPanel">
        <Setter Property="Background" >
            <Setter.Value>
                <LinearGradientBrush StartPoint="0%, 0%" EndPoint="100%, 0%">
                    <GradientStop Color="#E8E8E8" Offset="0.0"/>
                    <GradientStop Color="#C8C8C8" Offset="1.0"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>
    
    <Style Selector="StackPanel">
        <Setter Property="Background" >
            <Setter.Value>
                <LinearGradientBrush StartPoint="0%, 0%" EndPoint="100%, 0%">
                    <GradientStop Color="#E8E8E8" Offset="0.0"/>
                    <GradientStop Color="#C8C8C8" Offset="1.0"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>
    
    <Style Selector="Grid">
        <Setter Property="Background" >
            <Setter.Value>
                <LinearGradientBrush StartPoint="0%, 0%" EndPoint="100%, 0%">
                    <GradientStop Color="#E8E8E8" Offset="0.0"/>
                    <GradientStop Color="#C8C8C8" Offset="1.0"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>
</Styles>
