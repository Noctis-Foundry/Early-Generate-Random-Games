<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Design.PreviewWith>
    </Design.PreviewWith>

    <Styles.Resources>
        <ImageBrush Source="avares://GameRandom/Assets/BaseWindowAssets/TextBlockBorder.png" Stretch="Fill" x:Key="TextBlockBackground"></ImageBrush>
        <ImageBrush Source="avares://GameRandom/Assets/BaseWindowAssets/CurrentGameBackground.png" Stretch="Fill" x:Key="DockPanelBrush"></ImageBrush>
        <ImageBrush Source="avares://GameRandom/Assets/BaseWindowAssets/buttonBorder.png" Stretch="Fill" x:Key="ButtonBackground"></ImageBrush>
        <ImageBrush Source="avares://GameRandom/Assets/BaseWindowAssets/ImageBorder.png" Stretch="Fill" x:Key="ImageBrush"></ImageBrush>
        <ImageBrush Source="avares://GameRandom/Assets/BaseWindowAssets/TopContainer.png" Stretch="Fill" x:Key="TopContainerBrush"></ImageBrush>
    </Styles.Resources>
    
    <!-- Main container style for the game info window background and spacing -->
    <Style Selector="DockPanel.WindowContainer">
        <Setter Property="Background" Value="{StaticResource DockPanelBrush}" />
    </Style>
    
    <Style Selector="StackPanel.WindowContainer">
        <Setter Property="Background" Value="{StaticResource DockPanelBrush}" />
    </Style>
    
    <Style Selector="Border.WindowTopContainer">
        <Setter Property="HorizontalAlignment" Value="Center"></Setter>
        <Setter Property="Margin" Value="0,5,0,0"></Setter>
        <Setter Property="Background" Value="{StaticResource TopContainerBrush}"></Setter>
        <Setter Property="Height" Value="50"></Setter>
        <Setter Property="Width" Value="200"></Setter>
    </Style>

    <!-- Grid layout style: centers content and defines spacing between rows and columns -->
    <Style Selector="Grid.WindowGrid">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="RowSpacing" Value="8" />
        <Setter Property="ColumnSpacing" Value="15" />
        <Setter Property="Margin" Value="5,0,0,0" />
    </Style>

    <!-- Style for individual info card borders: dark background with rounded corners and padding -->
    <Style Selector="Border.WindowTextBorder">
        <Setter Property="Background" Value="{StaticResource TextBlockBackground}"/>
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="30,10,30,5"/>
    </Style>

    <!-- Style for info text labels: white text, centered, with wrapping and size constraints -->
    <Style Selector="TextBlock.WindowTextBlock">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontFamily" Value="{StaticResource 'Anime Ace'}"></Setter>
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="TextAlignment" Value="Center" />
    </Style>
    
    <Style Selector="SelectableTextBlock.WindowTextBlock">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontFamily" Value="{StaticResource 'Anime Ace'}"></Setter>
        <Setter Property="FontSize" Value="14" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="TextAlignment" Value="Center" />
    </Style>

    <!-- Animated border style for game image with rotating conic gradient outline -->
    <Style Selector="Border.WindowImageBorder">
        <Setter Property="Background" Value="{StaticResource ImageBrush}"></Setter>
        <Setter Property="Margin" Value="0,0,20,0"></Setter>
        <Setter Property="HorizontalAlignment" Value="Right"></Setter>
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Width" Value="350" />
        <Setter Property="Height" Value="250" />
        <Setter Property="MaxWidth" Value="450" />
        <Setter Property="MinWidth" Value="350" />
        <Setter Property="MaxHeight" Value="250" />
        <Setter Property="MinHeight" Value="200" />
    </Style>
    
    <Style Selector="Image.WindowHeaderImage">
        <Setter Property="MaxHeight" Value="187" />
        <Setter Property="MaxWidth" Value="300" />
        <Setter Property="Stretch" Value="UniformToFill" />
    </Style>

    
    <Style Selector="Image.WindowHeaderImage">
        <Setter Property="MaxHeight" Value="187" />
        <Setter Property="MaxWidth" Value="300" />
        <Setter Property="Stretch" Value="Fill" />
    </Style>

    <!-- Button hover style: animated conic gradient border on pointer over -->
    <Style Selector="Button.WindowButton:pointerover /template/ContentPresenter">
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush">
        </Setter>
        <Style.Animations>
            <Animation Duration="0:0:3" IterationCount="Infinite">
                <KeyFrame Cue="0%">
                    <Setter Property="BorderBrush">
                        <Setter.Value>
                            <ConicGradientBrush Center="50%,50%" Angle="0">
                                <GradientStop Color="#bb9e67" Offset="0" />
                                <GradientStop Color="{StaticResource GradientColorMiddle}" Offset="0.5" />
                                <GradientStop Color="{StaticResource GradientColorEnd}" Offset="1" />
                            </ConicGradientBrush>
                        </Setter.Value>
                    </Setter>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="BorderBrush">
                        <Setter.Value>
                            <ConicGradientBrush Center="50%,50%" Angle="360">
                                <GradientStop Color="#bb9e67" Offset="0" />
                                <GradientStop Color="{StaticResource GradientColorMiddle}" Offset="0.5" />
                                <GradientStop Color="{StaticResource GradientColorEnd}" Offset="1" />
                            </ConicGradientBrush>
                        </Setter.Value>
                    </Setter>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    
    <!-- Свойства самой кнопки -->
    <Style Selector="Button.WindowButton">
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center"></Setter>
        <Setter Property="FontSize" Value="16" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="MinWidth" Value="150" />
    </Style>

    <!-- Свойства ContentPresenter -->
    <Style Selector="Button.WindowButton /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource ButtonBackground}" />
        <Setter Property="Foreground" Value="White"></Setter>
        <Setter Property="CornerRadius" Value="4" />
    </Style>

</Styles>